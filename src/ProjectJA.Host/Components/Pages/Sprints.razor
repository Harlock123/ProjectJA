@page "/projects/{projectId:guid}/sprints"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using System.Text.Json
@using ProjectJA.Modules.Audit.Domain
@using ProjectJA.Modules.Projects.Contracts
@using ProjectJA.Modules.Projects.Domain
@using ProjectJA.Modules.Issues.Contracts
@using ProjectJA.Modules.Issues.Domain
@using ProjectJA.Modules.Workflows.Contracts
@using ProjectJA.Modules.Workflows.Domain
@using ProjectJA.SharedKernel.Audit
@inject AppDbContext Db
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IClock Clock
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@inject IProjectQueries Projects
@inject ISprintQueries SprintQueriesSvc
@inject ISprintIssueOps SprintIssueOpsSvc
@inject IWorkflowQueries WorkflowsQueries
@inject IAuditLog Audit

<PageTitle>@(_project is null ? "Sprints" : $"{_project.Key} sprints")</PageTitle>

@if (_project is null)
{
    <MudText>Loading…</MudText>
}
else
{
    <MudButton Href="@($"/projects/{ProjectId}")" Variant="Variant.Text"
               StartIcon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="mb-2">Back to project</MudButton>

    <MudStack Row="true" AlignItems="AlignItems.Baseline" Class="mb-4">
        <MudText Typo="Typo.h4">
            <span style="font-family:monospace;">@_project.Key</span> sprints
        </MudText>
        <MudSpacer />
        @if (_isAdmin)
        {
            <MudButton Href="@($"/projects/{ProjectId}/sprints/plan")" Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.DragIndicator">Plan (drag &amp; drop)</MudButton>
        }
    </MudStack>

    @if (!_isAdmin)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            Read-only access to sprints. Only project Admins can create, start, complete, or delete sprints.
        </MudAlert>
    }

    @if (_sprints.Count == 0)
    {
        <MudText Color="Color.Default" Class="mb-4">No sprints yet.</MudText>
    }
    else
    {
        <MudExpansionPanels MultiExpansion="true" Class="mb-4">
            @foreach (var s in _sprints)
            {
                var count = _issueCounts.GetValueOrDefault(s.Id, 0);
                var issues = _issuesBySprint.GetValueOrDefault(s.Id) ?? new List<Issue>();
                <MudExpansionPanel @key="s.Id">
                    <TitleContent>
                        <div style="display:flex;align-items:center;gap:0.75rem;width:100%;">
                            <strong>@s.Name</strong>
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(s.Status)">@s.Status</MudChip>
                            @if (!string.IsNullOrWhiteSpace(s.Goal))
                            {
                                <span style="color:#888;font-size:0.85rem;">@s.Goal</span>
                            }
                            <MudSpacer />
                            <span style="color:#888;font-size:0.85rem;">@count issue(s)</span>
                            @if (s.StartedAt is { } st)
                            {
                                <span style="color:#888;font-size:0.85rem;">· started @st.ToString("yyyy-MM-dd")</span>
                            }
                            @if (s.CompletedAt is { } co)
                            {
                                <span style="color:#888;font-size:0.85rem;">· completed @co.ToString("yyyy-MM-dd")</span>
                            }
                        </div>
                    </TitleContent>
                    <ChildContent>
                        @* Action row — Admin only *@
                        @if (_isAdmin)
                        {
                            <MudStack Row="true" Spacing="2" Class="mb-3">
                                @if (s.Status == SprintStatus.Planned)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                               StartIcon="@Icons.Material.Filled.PlayArrow"
                                               OnClick="@(() => StartAsync(s))">Start</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.Delete"
                                               OnClick="@(() => DeleteAsync(s))">Delete</MudButton>
                                }
                                else if (s.Status == SprintStatus.Active)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                               StartIcon="@Icons.Material.Filled.Stop"
                                               OnClick="@(() => CompleteAsync(s))">Complete</MudButton>
                                }
                                <MudSpacer />
                                <MudText Typo="Typo.caption" Color="Color.Default">
                                    Planned: @FormatRange(s.PlannedStart, s.PlannedEnd)
                                </MudText>
                            </MudStack>
                        }

                        @* Report: counts + points by workflow-state Category.
                           States have custom names per project but always fall
                           into Open / InProgress / Done — those buckets are the
                           meaningful axis. *@
                        @{
                            int totalCount = issues.Count;
                            int totalPoints = issues.Sum(i => i.Points ?? 0);
                            (int c, int p) ByCat(WorkflowStateCategory cat) =>
                                (issues.Count(i => _stateCategories.GetValueOrDefault(i.WorkflowStateId) == cat),
                                 issues.Where(i => _stateCategories.GetValueOrDefault(i.WorkflowStateId) == cat).Sum(i => i.Points ?? 0));
                            var (openC, openP) = ByCat(WorkflowStateCategory.Open);
                            var (ipC, ipP) = ByCat(WorkflowStateCategory.InProgress);
                            var (doneC, doneP) = ByCat(WorkflowStateCategory.Done);
                        }
                        <MudStack Row="true" Spacing="3" Class="mb-3">
                            <MudPaper Class="pa-2" Outlined="true" Style="min-width:8rem;">
                                <MudText Typo="Typo.caption" Color="Color.Default">Open</MudText>
                                <MudText Typo="Typo.body1"><strong>@openC</strong> issue(s) · @openP pt(s)</MudText>
                            </MudPaper>
                            <MudPaper Class="pa-2" Outlined="true" Style="min-width:8rem;">
                                <MudText Typo="Typo.caption" Color="Color.Default">In progress</MudText>
                                <MudText Typo="Typo.body1"><strong>@ipC</strong> issue(s) · @ipP pt(s)</MudText>
                            </MudPaper>
                            <MudPaper Class="pa-2" Outlined="true" Style="min-width:8rem;">
                                <MudText Typo="Typo.caption" Color="Color.Default">Done</MudText>
                                <MudText Typo="Typo.body1"><strong>@doneC</strong> issue(s) · @doneP pt(s)</MudText>
                            </MudPaper>
                            <MudPaper Class="pa-2" Outlined="true" Style="min-width:8rem;">
                                <MudText Typo="Typo.caption" Color="Color.Default">Total</MudText>
                                <MudText Typo="Typo.body1"><strong>@totalCount</strong> issue(s) · @totalPoints pt(s)</MudText>
                            </MudPaper>
                            @* For Completed sprints, surface the count of issues that were
                               cleared back to backlog at close-time (recorded only in the
                               `sprint.completed` audit row's Detail). *@
                            @if (s.Status == SprintStatus.Completed)
                            {
                                <MudPaper Class="pa-2" Outlined="true" Style="min-width:10rem;">
                                    <MudText Typo="Typo.caption" Color="Color.Default">Carried over to backlog</MudText>
                                    @if (_carriedOver.TryGetValue(s.Id, out var carry))
                                    {
                                        <MudText Typo="Typo.body1"><strong>@carry</strong> issue(s) at close</MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Default">— (audit row not available)</MudText>
                                    }
                                </MudPaper>
                            }
                        </MudStack>

                        @if (issues.Count == 0)
                        {
                            <MudText Color="Color.Default">No issues in this sprint.</MudText>
                        }
                        else
                        {
                            <MudTable Items="issues" Hover="true" Dense="true">
                                <HeaderContent>
                                    <MudTh Style="width:7rem;">Key</MudTh>
                                    <MudTh>Title</MudTh>
                                    <MudTh Style="width:6rem;">Status</MudTh>
                                    <MudTh Style="width:5rem;">Points</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>
                                        <MudLink Href="@($"/issues/{context.Id}")" Style="font-family:monospace;">@_project!.Key-@context.Number</MudLink>
                                    </MudTd>
                                    <MudTd>@context.Title</MudTd>
                                    <MudTd><MudChip T="string" Size="Size.Small">@(_stateNames.GetValueOrDefault(context.WorkflowStateId, "?"))</MudChip></MudTd>
                                    <MudTd>@(context.Points?.ToString() ?? "—")</MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }

    @if (_isAdmin)
    {
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" GutterBottom="true">Plan a sprint</MudText>
            <MudText Typo="Typo.body2" Color="Color.Default" Class="mb-3">
                A new sprint starts in <em>Planned</em>. Use <strong>Start</strong> on its row when you're ready
                — only one sprint can be Active in a project at a time.
            </MudText>
            <MudStack Spacing="3">
                <MudTextField Label="Name"
                              Placeholder="e.g. Sprint 2026.05"
                              @bind-Value="_draft.Name"
                              Variant="Variant.Outlined" Required="true" MaxLength="200" />
                <MudTextField Label="Goal (optional)"
                              Placeholder="What does this sprint aim to deliver?"
                              @bind-Value="_draft.Goal"
                              Variant="Variant.Outlined" Lines="2" />
                <MudStack Row="true" Spacing="2">
                    <MudDatePicker Label="Planned start" @bind-Date="_draft.PlannedStart" />
                    <MudDatePicker Label="Planned end" @bind-Date="_draft.PlannedEnd" />
                </MudStack>
                <MudButton OnClick="CreateAsync" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Add">Create sprint</MudButton>
                @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
            </MudStack>
        </MudPaper>
    }
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private Project? _project;
    private Guid _currentUserId;
    private bool _isAdmin;
    private IReadOnlyList<SprintSummary> _sprints = Array.Empty<SprintSummary>();
    private Dictionary<Guid, int> _issueCounts = new();
    private Dictionary<Guid, string> _stateNames = new();
    private Dictionary<Guid, WorkflowStateCategory> _stateCategories = new();
    // For Completed sprints: count of issues that were returned to backlog at
    // completion time, parsed from the existing `sprint.completed` audit row's
    // Detail JSON. Empty if the audit row is missing (e.g. purged by the
    // retention job).
    private Dictionary<Guid, int> _carriedOver = new();
    private Dictionary<Guid, List<Issue>> _issuesBySprint = new();
    private Draft _draft = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        Guid.TryParse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), out _currentUserId);
        var role = await Projects.GetRoleAsync(ProjectId, _currentUserId, default);
        if (role is null)
        {
            Nav.NavigateTo("/projects?denied=1");
            return;
        }
        _isAdmin = role.Value == ProjectRole.Admin;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        Db.ChangeTracker.Clear();
        _project = await Db.Projects.AsNoTracking().FirstOrDefaultAsync(p => p.Id == ProjectId);
        if (_project is null) return;
        _sprints = await SprintQueriesSvc.ListForProjectAsync(ProjectId, default);
        var wf = await WorkflowsQueries.GetForProjectAsync(ProjectId, default);
        _stateNames = wf?.States.ToDictionary(s => s.Id, s => s.Name) ?? new();
        _stateCategories = wf?.States.ToDictionary(s => s.Id, s => s.Category) ?? new();
        await LoadCarriedOverAsync();
    }

    // Reads back the `sprint.completed` audit rows for this project and parses
    // each Detail JSON for `sprintId` + `issuesReturnedToBacklog`. The count
    // isn't denormalized on the Sprint row (deliberate anti-bloat in Slice 4
    // — the audit log was the single source); this surfaces it without
    // schema change.
    private async Task LoadCarriedOverAsync()
    {
        _carriedOver = new();
        var resourceId = ProjectId.ToString();
        var rows = await Db.Set<AuditEvent>().AsNoTracking()
            .Where(e => e.Action == "sprint.completed"
                        && e.ResourceType == "Project"
                        && e.ResourceId == resourceId
                        && e.Detail != null)
            .Select(e => e.Detail!)
            .ToListAsync();
        foreach (var json in rows)
        {
            try
            {
                using var doc = JsonDocument.Parse(json);
                if (!doc.RootElement.TryGetProperty("sprintId", out var sidEl)) continue;
                if (!doc.RootElement.TryGetProperty("issuesReturnedToBacklog", out var cEl)) continue;
                if (!Guid.TryParse(sidEl.GetString(), out var sid)) continue;
                _carriedOver[sid] = cEl.GetInt32();
            }
            catch (JsonException) { /* skip malformed rows; one bad row musn't kill the page */ }
        }
        // Load every assigned issue once and group locally — the inline report
        // needs the full list (not just counts) for the per-status breakdown.
        var assigned = await Db.Issues.AsNoTracking()
            .Where(i => i.ProjectId == ProjectId && i.SprintId != null)
            .OrderBy(i => i.Number)
            .ToListAsync();
        _issuesBySprint = assigned.GroupBy(i => i.SprintId!.Value)
            .ToDictionary(g => g.Key, g => g.ToList());
        _issueCounts = _issuesBySprint.ToDictionary(kv => kv.Key, kv => kv.Value.Count);
    }

    private async Task CreateAsync()
    {
        _error = null;
        if (!_isAdmin) { _error = "Only Admins can create sprints."; return; }
        if (string.IsNullOrWhiteSpace(_draft.Name)) { _error = "Name is required."; return; }
        try
        {
            await using var db = DbFactory.CreateDbContext();
            var sprint = Sprint.Create(ProjectId, _draft.Name,
                _draft.Goal,
                ToOffset(_draft.PlannedStart),
                ToOffset(_draft.PlannedEnd),
                Clock.UtcNow);
            db.Set<Sprint>().Add(sprint);
            await db.SaveChangesAsync();

            await AuditAsync("sprint.created",
                $"Created sprint \"{sprint.Name}\" in {_project?.Key}",
                new { sprintId = sprint.Id, sprint.Name, sprint.Goal, sprint.PlannedStart, sprint.PlannedEnd, projectKey = _project?.Key });

            _draft = new Draft();
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task StartAsync(SprintSummary s)
    {
        _error = null;
        if (!_isAdmin) return;
        try
        {
            // One-Active-per-project invariant enforced at the application layer
            // (the domain just gates Planned→Active).
            if (await SprintQueriesSvc.HasActiveSprintAsync(ProjectId, default))
            {
                _error = "Another sprint is already Active in this project. Complete it first.";
                return;
            }
            await using var db = DbFactory.CreateDbContext();
            var tracked = await db.Set<Sprint>().FirstAsync(x => x.Id == s.Id);
            tracked.Start(Clock.UtcNow);
            await db.SaveChangesAsync();

            await AuditAsync("sprint.started",
                $"Started sprint \"{tracked.Name}\" in {_project?.Key}",
                new { sprintId = tracked.Id, tracked.Name, startedAt = tracked.StartedAt, projectKey = _project?.Key });

            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task CompleteAsync(SprintSummary s)
    {
        _error = null;
        if (!_isAdmin) return;
        try
        {
            await using var db = DbFactory.CreateDbContext();
            var tracked = await db.Set<Sprint>().FirstAsync(x => x.Id == s.Id);
            tracked.Complete(Clock.UtcNow);
            await db.SaveChangesAsync();
            // Push still-open issues back to backlog. Separate operation; if it
            // fails the sprint is still Completed and a retry is idempotent.
            var moved = await SprintIssueOpsSvc.ClearSprintForIncompleteAsync(tracked.Id, Clock.UtcNow, default);

            await AuditAsync("sprint.completed",
                $"Completed sprint \"{tracked.Name}\" in {_project?.Key} ({moved} issue(s) returned to backlog)",
                new { sprintId = tracked.Id, tracked.Name, completedAt = tracked.CompletedAt, issuesReturnedToBacklog = moved, projectKey = _project?.Key });

            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task DeleteAsync(SprintSummary s)
    {
        _error = null;
        if (!_isAdmin) return;
        if (s.Status != SprintStatus.Planned)
        {
            _error = "Only a Planned sprint can be deleted.";
            return;
        }
        try
        {
            if (await SprintIssueOpsSvc.HasAnyIssuesInSprintAsync(s.Id, default))
            {
                _error = "Sprint still has assigned issues — move them to the backlog first.";
                return;
            }
            await using var db = DbFactory.CreateDbContext();
            var tracked = await db.Set<Sprint>().FirstAsync(x => x.Id == s.Id);
            var name = tracked.Name;
            db.Set<Sprint>().Remove(tracked);
            await db.SaveChangesAsync();

            await AuditAsync("sprint.deleted",
                $"Deleted sprint \"{name}\" in {_project?.Key}",
                new { sprintId = s.Id, name, projectKey = _project?.Key });

            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    // Audit is best-effort: the membership change is already committed. Actor
    // passed explicitly — interactive circuit, no HttpContext.
    private async Task AuditAsync(string action, string summary, object detail)
    {
        try
        {
            await Audit.RecordAsync(
                new AuditEntry(action, "Project", ProjectId.ToString(), summary, detail, _currentUserId),
                default);
        }
        catch { /* swallowed by design */ }
    }

    private static DateTimeOffset? ToOffset(DateTime? d) =>
        d.HasValue ? new DateTimeOffset(DateTime.SpecifyKind(d.Value, DateTimeKind.Utc)) : null;

    private static string FormatRange(DateTimeOffset? a, DateTimeOffset? b)
    {
        if (a is null && b is null) return "—";
        var s = a?.ToString("yyyy-MM-dd") ?? "?";
        var e = b?.ToString("yyyy-MM-dd") ?? "?";
        return $"{s} → {e}";
    }

    private static Color StatusColor(SprintStatus s) => s switch
    {
        SprintStatus.Planned => Color.Default,
        SprintStatus.Active => Color.Success,
        SprintStatus.Completed => Color.Info,
        _ => Color.Default,
    };

    private sealed class Draft
    {
        public string Name { get; set; } = "";
        public string? Goal { get; set; }
        public DateTime? PlannedStart { get; set; }
        public DateTime? PlannedEnd { get; set; }
    }
}
