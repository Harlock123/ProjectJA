@page "/accept-invite"

<PageTitle>Accept invite</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h5" GutterBottom="true">Accept your invite</MudText>

        @if (string.IsNullOrWhiteSpace(Token))
        {
            <MudAlert Severity="Severity.Error">This URL is missing the invite token.</MudAlert>
        }
        else
        {
            @* Plain HTTP form posting to the /accept-invite/submit endpoint.
               It must NOT be an interactive EditForm: accepting an invite
               signs the new user in, and a cookie write in the SignalR
               circuit throws "Headers are read-only". A cross-document POST
               hits a real HTTP request where SignInManager can set it. *@
            <form method="post" action="/accept-invite/submit">
                <input type="hidden" name="token" value="@Token" />
                <MudStack Spacing="3">
                    <div>
                        <label for="ai-first" class="mud-typography mud-typography-body2">First name</label>
                        <input id="ai-first" name="firstName" autocomplete="given-name" class="ssr-input" required />
                    </div>
                    <div>
                        <label for="ai-last" class="mud-typography mud-typography-body2">Last name</label>
                        <input id="ai-last" name="lastName" autocomplete="family-name" class="ssr-input" required />
                    </div>
                    <div>
                        <label for="ai-pwd" class="mud-typography mud-typography-body2">Password</label>
                        <input id="ai-pwd" name="password" type="password" autocomplete="new-password" class="ssr-input" required />
                    </div>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
                        Create account
                    </MudButton>
                    @if (_error is not null)
                    {
                        <MudAlert Severity="Severity.Error">@_error</MudAlert>
                    }
                </MudStack>
            </form>
            <style>
                .ssr-input {
                    width: 100%; padding: 0.6rem 0.75rem; border: 1px solid rgba(0,0,0,0.23);
                    border-radius: 4px; font: inherit; box-sizing: border-box; background: white;
                }
                .ssr-input:focus { outline: 2px solid #594ae2; outline-offset: -1px; }
            </style>
        }
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private string? _error;

    protected override void OnInitialized() =>
        _error = string.IsNullOrWhiteSpace(Error) ? null : Error;
}
