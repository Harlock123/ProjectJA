@page "/"
@rendermode InteractiveServer

<PageTitle>ProjectJA</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-6" Elevation="1">
        <MudText Typo="Typo.h3" GutterBottom="true">ProjectJA</MudText>
        <MudText Typo="Typo.body1" Color="Color.Default" Class="mb-4">A lightweight issue tracker.</MudText>
        <MudButton Href="/projects" Variant="Variant.Filled" Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.ArrowForward">Go to projects</MudButton>
    </MudPaper>
</MudContainer>
