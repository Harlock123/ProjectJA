@page "/reset-password"
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using ProjectJA.Modules.Identity.Domain
@using ProjectJA.SharedKernel.Audit
@inject UserManager<ApplicationUser> Users
@inject IAuditLog Audit
@inject NavigationManager Nav

<PageTitle>Reset password</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-6" Elevation="2">
        <MudText Typo="Typo.h5" GutterBottom="true">Reset password</MudText>

        @if (string.IsNullOrWhiteSpace(Token) || string.IsNullOrWhiteSpace(Email))
        {
            <MudAlert Severity="Severity.Error">This reset link is invalid or incomplete.</MudAlert>
            <MudButton Href="/forgot-password" Variant="Variant.Text" Color="Color.Primary" Class="mt-4">Request a new link</MudButton>
        }
        else if (_completed)
        {
            <MudAlert Severity="Severity.Success">Password updated. You can sign in now.</MudAlert>
            <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Sign in</MudButton>
        }
        else
        {
            <EditForm Model="Input" method="post" OnValidSubmit="SubmitAsync" FormName="reset-password">
                <input type="hidden" name="Token" value="@Token" />
                <input type="hidden" name="Email" value="@Email" />
                <MudStack Spacing="3">
                    <MudText Typo="Typo.body2" Color="Color.Default">
                        Setting a new password for <strong>@Email</strong>.
                    </MudText>
                    <div>
                        <label for="rp-pwd" class="mud-typography mud-typography-body2">New password</label>
                        <InputText id="rp-pwd" @bind-Value="Input.Password" type="password" autocomplete="new-password" class="ssr-input" />
                    </div>
                    <div>
                        <label for="rp-confirm" class="mud-typography mud-typography-body2">Confirm password</label>
                        <InputText id="rp-confirm" @bind-Value="Input.ConfirmPassword" type="password" autocomplete="new-password" class="ssr-input" />
                    </div>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
                        Reset password
                    </MudButton>
                    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
                </MudStack>
            </EditForm>
            <style>
                .ssr-input {
                    width: 100%; padding: 0.6rem 0.75rem; border: 1px solid rgba(0,0,0,0.23);
                    border-radius: 4px; font: inherit; box-sizing: border-box; background: white;
                }
            </style>
        }
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromForm] public InputModel Input { get; set; } = new();

    private bool _completed;
    private string? _error;

    private async Task SubmitAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(Token) || string.IsNullOrWhiteSpace(Email))
        {
            _error = "Reset link is invalid.";
            return;
        }
        if (string.IsNullOrEmpty(Input.Password) || Input.Password.Length < 8)
        {
            _error = "Password must be at least 8 characters.";
            return;
        }
        if (Input.Password != Input.ConfirmPassword)
        {
            _error = "Passwords do not match.";
            return;
        }

        var user = await Users.FindByEmailAsync(Email);
        if (user is null)
        {
            _error = "Reset link is invalid or expired.";
            return;
        }

        string decodedToken;
        try
        {
            decodedToken = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Token));
        }
        catch
        {
            _error = "Reset link is invalid.";
            return;
        }

        var result = await Users.ResetPasswordAsync(user, decodedToken, Input.Password);
        if (!result.Succeeded)
        {
            _error = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        await Audit.RecordAsync(new AuditEntry(
            Action: "password.reset.completed",
            ResourceType: "User",
            ResourceId: user.Id.ToString(),
            Summary: $"Password reset completed for {user.Email}"), default);

        _completed = true;
    }

    public sealed class InputModel
    {
        public string Password { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}
