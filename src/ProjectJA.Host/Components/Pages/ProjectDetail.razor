@page "/projects/{projectId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using ProjectJA.Modules.Identity.Contracts
@using ProjectJA.Modules.Projects.Contracts
@using ProjectJA.Modules.Projects.Domain
@using ProjectJA.Modules.Workflows.Contracts
@using ProjectJA.Modules.Workflows.Domain
@using ProjectJA.Host.Components.Dialogs
@inject AppDbContext Db
@inject IClock Clock
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@inject IUserQueries Users
@inject IProjectQueries Projects
@inject ISprintQueries SprintsQueries
@inject IWorkflowQueries WorkflowsQueries
@inject IDialogService DialogService

<PageTitle>@(_project?.Name ?? "Project")</PageTitle>

@if (_project is null)
{
    <MudText>Loading…</MudText>
}
else
{
    <MudButton Href="/projects" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="mb-2">All projects</MudButton>

    <MudStack Row="true" AlignItems="AlignItems.Baseline" Class="mb-4">
        <MudText Typo="Typo.h4"><span style="font-family:monospace;">@_project.Key</span> — @_project.Name</MudText>
        <MudSpacer />
        <MudButton OnClick="OpenMembersAsync" Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Group" Class="mr-2">Membership</MudButton>
        <MudButton Href="@($"/projects/{ProjectId}/workflow")" Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AccountTree" Class="mr-2">Workflow</MudButton>
        <MudButton Href="@($"/projects/{ProjectId}/sprints")" Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Loop" Class="mr-2">Sprints</MudButton>
        <MudButton Href="@($"/projects/{ProjectId}/board")" Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ViewKanban">Board</MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_project.Description))
    {
        <MudPaper Class="pa-3 mb-4" Elevation="0" Style="background:#f7f7f7;">
            <MudText Typo="Typo.body2">@_project.Description</MudText>
        </MudPaper>
    }

    <MudGrid>
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" GutterBottom="true">Issues</MudText>
                @if (_issues is null || _issues.Count == 0)
                {
                    <MudText Color="Color.Default">No issues yet.</MudText>
                }
                else
                {
                    <MudTable Items="_issues" Hover="true" Dense="true">
                        <HeaderContent>
                            <MudTh>Key</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Priority</MudTh>
                            <MudTh>Title</MudTh>
                            <MudTh Style="width:5rem;">Pts</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Updated</MudTh>
                            <MudTh Style="width:3rem;"></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><MudLink Href="@($"/issues/{context.Id}")" Style="font-family:monospace;">@_project.Key-@context.Number</MudLink></MudTd>
                            <MudTd><MudChip T="string" Size="Size.Small" Color="@TypeColor(context.Type)" Variant="Variant.Outlined">@context.Type</MudChip></MudTd>
                            <MudTd><MudChip T="string" Size="Size.Small" Color="@PriorityColor(context.Priority)">@context.Priority</MudChip></MudTd>
                            <MudTd style="cursor:pointer;" title="Double-click to edit"
                                   @ondblclick="@(() => OpenEditAsync(context.Id))">
                                @context.Title
                                @if (context.SprintId is { } sid && _sprintNames.TryGetValue(sid, out var sname))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled" Class="ml-2"
                                             Icon="@Icons.Material.Filled.Loop">@sname</MudChip>
                                }
                                @if (context.Labels.Count > 0)
                                {
                                    <div class="mt-1">
                                        @foreach (var lbl in context.Labels)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="mr-1">@lbl</MudChip>
                                        }
                                    </div>
                                }
                            </MudTd>
                            <MudTd>@(context.Points?.ToString() ?? "—")</MudTd>
                            <MudTd>
                                @if (_canWrite && _workflow is not null)
                                {
                                    <MudSelect T="Guid" Value="context.WorkflowStateId"
                                               ValueChanged="@(v => TransitionAsync(context, v))"
                                               Dense="true" Margin="Margin.Dense">
                                        @foreach (var s in _workflow.States.OrderBy(s => s.Order))
                                        {
                                            <MudSelectItem Value="@s.Id">@s.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2">@(_stateNames.GetValueOrDefault(context.WorkflowStateId, "—"))</MudText>
                                }
                            </MudTd>
                            <MudTd><MudText Typo="Typo.body2" Color="Color.Default">@context.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</MudText></MudTd>
                            <MudTd>
                                <MudIconButton Icon="@(_canWrite ? Icons.Material.Filled.Edit : Icons.Material.Filled.Visibility)"
                                               Size="Size.Small" Color="Color.Primary"
                                               title="@(_canWrite ? "Edit issue" : "View issue")"
                                               OnClick="@(() => OpenEditAsync(context.Id))" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="1">
                @if (!_canWrite)
                {
                    <MudText Typo="Typo.h6" GutterBottom="true">Issues</MudText>
                    <MudAlert Severity="Severity.Info" Dense="true">
                        You have <strong>read-only</strong> (@_role) access to this project.
                        Ask a project Admin for the Member role to create or edit issues.
                    </MudAlert>
                }
                else
                {
                <MudText Typo="Typo.h6" GutterBottom="true">Create an issue</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default" Class="mb-3">
                    Issues are work items in this project. The next one will be
                    <strong>@_project.Key-@(_project.NextIssueNumber)</strong> and starts in
                    <em>Todo</em>; drag it on the board to change status.
                </MudText>
                <MudStack Spacing="3">
                    <MudTextField Label="Title"
                                  Placeholder="One-line summary of the work"
                                  HelperText="Required. Keep it short — details go in the description."
                                  @bind-Value="_draft.Title"
                                  Variant="Variant.Outlined" Required="true" MaxLength="300" />
                    <MudTextField Label="Description (optional)"
                                  Placeholder="Context, links…"
                                  @bind-Value="_draft.Description"
                                  Variant="Variant.Outlined" Lines="4" />
                    <MudSelect T="IssueType" Label="Type" @bind-Value="_draft.Type"
                               Variant="Variant.Outlined" Dense="true">
                        @foreach (var t in Enum.GetValues<IssueType>())
                        {
                            <MudSelectItem Value="t">@t</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="IssuePriority" Label="Priority" @bind-Value="_draft.Priority"
                               Variant="Variant.Outlined" Dense="true">
                        @foreach (var p in Enum.GetValues<IssuePriority>())
                        {
                            <MudSelectItem Value="p">@p</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField Label="Labels (optional)" @bind-Value="_draft.Labels"
                                  Placeholder="comma-separated, e.g. backend, urgent"
                                  HelperText="Free-text tags, comma-separated."
                                  Variant="Variant.Outlined" />
                    <MudNumericField T="int?" Label="Points (optional)" @bind-Value="_draft.Points"
                                     Variant="Variant.Outlined" Min="0" Max="100"
                                     HelperText="Relative effort estimate; leave blank if unestimated." />
                    <MudSelect T="Guid?" Label="Assignee (optional)" @bind-Value="_draft.AssigneeId"
                               Variant="Variant.Outlined" Dense="true" Clearable="true">
                        @foreach (var u in _users)
                        {
                            <MudSelectItem T="Guid?" Value="@u.Id">@u.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                    @if (_isAdmin)
                    {
                        var assignable = _sprints.Where(s => s.Status != SprintStatus.Completed).ToList();
                        <MudSelect T="Guid?" Label="Sprint (optional, Admin)" @bind-Value="_draft.SprintId"
                                   Variant="Variant.Outlined" Dense="true" Clearable="true"
                                   HelperText="Leave empty for backlog. Only Admins can change an issue's sprint.">
                            @foreach (var s in assignable)
                            {
                                <MudSelectItem T="Guid?" Value="@s.Id">@s.Name (@s.Status)</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    <MudButton OnClick="CreateAsync" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Add">Create issue</MudButton>
                    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
                </MudStack>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private Project? _project;
    private List<Issue>? _issues;
    private IReadOnlyList<UserSummary> _users = Array.Empty<UserSummary>();
    private IReadOnlyList<SprintSummary> _sprints = Array.Empty<SprintSummary>();
    private Dictionary<Guid, string> _sprintNames = new();
    private WorkflowView? _workflow;
    private Dictionary<Guid, string> _stateNames = new();
    private Guid _currentUserId;
    private ProjectRole? _role;
    private bool _canWrite;
    private bool _isAdmin;
    private Draft _draft = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        Guid.TryParse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), out _currentUserId);
        _role = await Projects.GetRoleAsync(ProjectId, _currentUserId, default);
        if (_role is null)
        {
            Nav.NavigateTo("/projects?denied=1");
            return;
        }
        _canWrite = _role.Value.CanWrite();
        _isAdmin = _role.Value == ProjectRole.Admin;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        // AsNoTracking + ChangeTracker.Clear: the same scoped AppDbContext lives for
        // the whole Blazor circuit, so without this we'd risk getting cached/tracked
        // copies instead of fresh rows after each create/edit.
        Db.ChangeTracker.Clear();
        _project = await Db.Projects.AsNoTracking().FirstOrDefaultAsync(p => p.Id == ProjectId);
        if (_project is null) return;
        _issues = await Db.Issues.AsNoTracking()
            .Where(i => i.ProjectId == ProjectId)
            .OrderBy(i => i.Number)
            .ToListAsync();
        _users = await Users.ListAllAsync(default);
        _workflow = await WorkflowsQueries.GetForProjectAsync(ProjectId, default);
        _stateNames = _workflow?.States.ToDictionary(s => s.Id, s => s.Name) ?? new();
        _sprints = await SprintsQueries.ListForProjectAsync(ProjectId, default);
        _sprintNames = _sprints.ToDictionary(s => s.Id, s => s.Name);
    }

    private async Task OpenMembersAsync()
    {
        var parameters = new DialogParameters<ProjectMembersDialog> { { x => x.ProjectId, ProjectId } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<ProjectMembersDialog>("Project members", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        // Membership may have changed the current user's own access — reload
        // (the page guard re-checks on the next navigation anyway).
        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CreateAsync()
    {
        _error = null;
        if (_project is null) return;
        if (!_canWrite)
        {
            _error = "Read-only access: only Members and Admins can create issues.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_draft.Title))
        {
            _error = "Title is required.";
            return;
        }

        var createdBy = _currentUserId != Guid.Empty
            ? _currentUserId
            : await Db.Users.Select(u => u.Id).FirstOrDefaultAsync();
        // Initial state = first Open-category state of the project's workflow
        // (defaults to "Todo" in the seeded default workflow).
        if (_workflow is null || _workflow.States.Count == 0)
        {
            _error = "Project has no workflow configured.";
            return;
        }
        var initialStateId = _workflow.States.OrderBy(s => s.Order)
            .FirstOrDefault(s => s.Category == WorkflowStateCategory.Open)?.Id
            ?? _workflow.States.OrderBy(s => s.Order).First().Id;
        var tracked = await Db.Projects.FirstAsync(p => p.Id == ProjectId);
        var number = tracked.AllocateIssueNumber();
        var issue = Issue.Create(tracked.Id, number, _draft.Title, _draft.Description,
            initialStateId, createdBy, Clock.UtcNow);
        issue.Reclassify(_draft.Type, _draft.Points, null, Clock.UtcNow);
        issue.SetPriority(_draft.Priority, Clock.UtcNow);
        issue.SetLabels(SplitLabels(_draft.Labels), Clock.UtcNow);
        if (_draft.AssigneeId is not null)
            issue.Assign(_draft.AssigneeId, Clock.UtcNow);
        // Only Admins can place a new issue directly into a sprint; the UI
        // only shows the dropdown to them, and we re-check here.
        if (_isAdmin && _draft.SprintId is not null)
            issue.AssignToSprint(_draft.SprintId, Clock.UtcNow);
        Db.Issues.Add(issue);
        await Db.SaveChangesAsync();
        _draft = new();
        await ReloadAsync();
    }

    private async Task TransitionAsync(Issue issue, Guid newStateId)
    {
        if (!_canWrite) return;
        // Defense-in-depth: target must belong to the project's workflow.
        if (_workflow?.States.Any(s => s.Id == newStateId) != true) return;
        if (issue.WorkflowStateId == newStateId) return;
        var tracked = await Db.Issues.FirstAsync(i => i.Id == issue.Id);
        tracked.Transition(newStateId, Clock.UtcNow);
        await Db.SaveChangesAsync();
        await ReloadAsync();
    }

    // Same modal the board opens on double-click. On save, reload the list so
    // the row reflects the edit.
    private async Task OpenEditAsync(Guid issueId)
    {
        var parameters = new DialogParameters<IssueEditDialog> { { x => x.IssueId, issueId } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<IssueEditDialog>("Edit issue", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static IEnumerable<string> SplitLabels(string? csv) =>
        string.IsNullOrWhiteSpace(csv)
            ? Array.Empty<string>()
            : csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static Color PriorityColor(IssuePriority p) => p switch
    {
        IssuePriority.Critical => Color.Error,
        IssuePriority.High => Color.Warning,
        IssuePriority.Medium => Color.Info,
        IssuePriority.Low => Color.Default,
        _ => Color.Default,
    };

    private static Color TypeColor(IssueType t) => t switch
    {
        IssueType.Story => Color.Info,
        IssueType.Defect => Color.Error,
        IssueType.Spike => Color.Secondary,
        IssueType.Epic => Color.Primary,
        IssueType.Enhancement => Color.Success,
        _ => Color.Default,
    };

    private sealed class Draft
    {
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public IssueType Type { get; set; } = IssueType.Task;
        public IssuePriority Priority { get; set; } = IssuePriority.Medium;
        public string? Labels { get; set; }
        public int? Points { get; set; }
        public Guid? AssigneeId { get; set; }
        public Guid? SprintId { get; set; }
    }
}
