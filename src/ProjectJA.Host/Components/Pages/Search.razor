@page "/search"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using ProjectJA.Modules.Issues.Contracts
@inject IIssueSearch IssueSearch

<PageTitle>Search</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Search issues</MudText>

<form method="get" action="/search" style="margin-bottom:1rem;">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <input type="text" name="q" value="@Q" placeholder="title, description…"
               style="padding:0.5rem;border:1px solid #ccc;border-radius:4px;width:24rem;" />
        <button type="submit" class="mud-button mud-button-filled mud-button-filled-primary mud-ripple"
                style="padding:0.4rem 1rem;border:none;border-radius:4px;background:#594ae2;color:white;cursor:pointer;">
            Search
        </button>
    </MudStack>
</form>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_results is null)
{
    <MudText Color="Color.Default">Enter a query above.</MudText>
}
else if (_results.Count == 0)
{
    <MudAlert Severity="Severity.Info">No matches for <strong>@Q</strong>.</MudAlert>
}
else
{
    <MudPaper Elevation="1">
        <MudTable Items="_results" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Issue</MudTh>
                <MudTh>Title</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="width:6rem;">Rank</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudLink Href="@($"/projects/{context.ProjectId}")" Style="font-family:monospace;">@context.ProjectKey-@context.Number</MudLink></MudTd>
                <MudTd>@context.Title</MudTd>
                <MudTd>@context.WorkflowStateName</MudTd>
                <MudTd><MudText Typo="Typo.body2" Color="Color.Default">@context.Rank.ToString("0.000")</MudText></MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    [SupplyParameterFromQuery] public string? Q { get; set; }

    private List<IssueSearchHit>? _results;
    private bool _loading;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(Q))
        {
            _results = null;
            return;
        }

        _loading = true;
        var hits = await IssueSearch.SearchAsync(Q, limit: 50, default);
        _results = hits.ToList();
        _loading = false;
    }
}
