@page "/admin/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "OrgAdmin")]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using ProjectJA.Modules.Identity.Domain
@using ProjectJA.SharedKernel.Audit
@inject AppDbContext Db
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<ApplicationUser> Users
@inject AuthenticationStateProvider Auth
@inject IAuditLog Audit
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ProjectJA.SharedKernel.Notifications.INotificationService Notifications

<PageTitle>Org users</PageTitle>

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h4">Org users</MudText>
    <HelpTooltip Text="Tenant-wide user administration. Toggle the Org admin switch to grant/revoke access to /invites, /audit, /admin/*, /system/versioning. The last-admin guard prevents demoting the only remaining org admin. The 2FA column lets you reset a non-admin user's two-factor (useful when they lose their phone) — admins must reset their own from Settings." />
</MudStack>
<MudText Typo="Typo.body2" Color="Color.Default" Class="mb-4">
    Org administrators have access to invites, audit, email outbox, SSO settings,
    system info, and this page. <strong>Project-level roles are independent</strong> —
    being an org admin doesn't auto-promote you on any project. A user must sign
    out and back in for a flag change to take effect (the value is stamped into
    the auth cookie at sign-in).
</MudText>

@if (_users is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Class="pa-4" Elevation="1">
        <MudTable Items="_users" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Email</MudTh>
                <MudTh Style="width:9rem;">Org admin</MudTh>
                <MudTh Style="width:11rem;">2FA</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.DisplayName</MudTd>
                <MudTd><span style="font-family:monospace;font-size:0.85rem;">@context.Email</span></MudTd>
                <MudTd>
                    <MudSwitch T="bool"
                               Value="context.IsOrgAdmin"
                               Color="Color.Success"
                               ValueChanged="@((bool v) => SetOrgAdminAsync(context, v))" />
                </MudTd>
                <MudTd>
                    @if (!context.TwoFactorEnabled)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Default">Off</MudText>
                    }
                    else if (context.IsOrgAdmin)
                    {
                        @* Deliberately not allowed: admins should disable their
                           own 2FA from /settings (current-password gated). *@
                        <MudText Typo="Typo.body2" Color="Color.Default" title="Org admins must manage their own 2FA from Settings.">On</MudText>
                    }
                    else
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.RemoveModerator"
                                   OnClick="@(() => DisableTwoFactorAsync(context))">
                            Disable 2FA
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert> }
        @if (_message is not null) { <MudAlert Severity="Severity.Info" Class="mt-3">@_message</MudAlert> }
    </MudPaper>
}

@code {
    private Guid _currentUserId;
    private List<Row>? _users;
    private string? _error;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        Guid.TryParse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), out _currentUserId);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        Db.ChangeTracker.Clear();
        _users = await Db.Set<ApplicationUser>().AsNoTracking()
            .OrderBy(u => u.LastName).ThenBy(u => u.FirstName).ThenBy(u => u.Email)
            .Select(u => new Row(
                u.Id,
                ((u.FirstName + " " + u.LastName).Trim() != "") ? (u.FirstName + " " + u.LastName).Trim() : (u.Email ?? "(unknown)"),
                u.Email ?? "",
                u.IsOrgAdmin,
                u.TwoFactorEnabled))
            .ToListAsync();
    }

    private async Task SetOrgAdminAsync(Row row, bool value)
    {
        _error = null;
        _message = null;
        if (row.IsOrgAdmin == value) return;

        // Last-admin guard: refuse to demote the last remaining org admin —
        // mirrors the project-Admin invariant in ProjectMembersDialog so the
        // tenant never gets stranded with no one who can manage it.
        if (!value)
        {
            var adminCount = await Db.Set<ApplicationUser>().AsNoTracking()
                .CountAsync(u => u.IsOrgAdmin);
            if (adminCount <= 1)
            {
                _error = "Can't demote the last org admin — promote someone else first.";
                return;
            }
        }

        try
        {
            await using var db = DbFactory.CreateDbContext();
            var tracked = await db.Set<ApplicationUser>().FirstAsync(u => u.Id == row.Id);
            tracked.IsOrgAdmin = value;
            await db.SaveChangesAsync();

            await AuditAsync("user.org_admin.set",
                value
                    ? $"Promoted {row.DisplayName} ({row.Email}) to org admin"
                    : $"Demoted {row.DisplayName} ({row.Email}) from org admin",
                new { targetUserId = row.Id, row.Email, isOrgAdmin = value });

            if (row.Id == _currentUserId && !value)
                _message = "You demoted yourself — sign out and back in to drop the org-admin claim. Until then this session retains access.";
            else if (row.Id != _currentUserId)
                _message = $"{row.DisplayName} must sign out and back in for the change to take effect.";

            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    // Best-effort audit (interactive circuit — no HttpContext, pass actor
    // explicitly via the AuditEntry.ActorId hook from the membership-audit slice).
    private async Task AuditAsync(string action, string summary, object detail)
    {
        try
        {
            await Audit.RecordAsync(
                new AuditEntry(action, "User", _currentUserId.ToString(), summary, detail, _currentUserId),
                default);
        }
        catch { /* swallowed */ }
    }

    private async Task DisableTwoFactorAsync(Row row)
    {
        _error = null;
        _message = null;

        // Belt-and-braces: refuse to act on an org admin via this path. The UI
        // already hides the button, but a stale grid row could lag behind a
        // promotion happening in another tab.
        if (row.IsOrgAdmin)
        {
            _error = "Org admins must disable their own 2FA from Settings.";
            return;
        }

        var confirm = await DialogService.ShowMessageBoxAsync(
            "Disable two-factor authentication?",
            $"This will turn off 2FA for {row.DisplayName} ({row.Email}) and invalidate their authenticator app and recovery codes. "
            + "They will sign in with only their password until they re-enroll. This action is audited.",
            yesText: "Disable 2FA",
            cancelText: "Cancel");
        if (confirm != true) return;

        try
        {
            var user = await Users.FindByIdAsync(row.Id.ToString());
            if (user is null) { _error = "User no longer exists."; return; }
            if (!user.TwoFactorEnabled) { _message = "User already had 2FA off."; return; }

            var result = await Users.SetTwoFactorEnabledAsync(user, false);
            if (!result.Succeeded)
            {
                _error = string.Join(" ", result.Errors.Select(e => e.Description));
                return;
            }
            // Rotate so any old authenticator pairing is dead even if it was
            // never actually used to sign in.
            await Users.ResetAuthenticatorKeyAsync(user);

            await AuditAsync("user.two_factor.admin_disabled",
                $"Disabled 2FA for {row.DisplayName} ({row.Email})",
                new { targetUserId = row.Id, row.Email });

            Snackbar.Add($"2FA disabled for {row.DisplayName}.", Severity.Success);
            try { await Notifications.OnTwoFactorDisabledAsync(row.Id, _currentUserId, default); }
            catch { /* best-effort */ }
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private sealed record Row(Guid Id, string DisplayName, string Email, bool IsOrgAdmin, bool TwoFactorEnabled);
}
