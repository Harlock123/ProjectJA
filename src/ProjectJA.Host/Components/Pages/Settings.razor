@page "/settings"
@page "/settings/appearance"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using ProjectJA.Host.Theming
@using ProjectJA.Modules.Identity.Contracts
@using ProjectJA.Modules.Identity.Domain
@using QRCoder
@inject ThemeCatalog Catalog
@inject AvatarCatalog Avatars
@inject ThemeState ThemeState
@inject AvatarState AvatarState
@inject TooltipState TooltipState
@inject IUserPreferences Preferences
@inject UserManager<ApplicationUser> Users
@inject AuthenticationStateProvider Auth
@inject ISnackbar Snackbar
@inject ProjectJA.SharedKernel.Notifications.INotificationService Notifications

<PageTitle>Settings</PageTitle>

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h4">Settings</MudText>
    <HelpTooltip Text="Account-scoped preferences: theme, avatar, password, two-factor authentication, and whether informational tooltips appear throughout the app." />
</MudStack>

<MudTabs Elevation="0" Rounded="true" KeepPanelsAlive="true">
    @* ------------------------------------------------------------ Appearance *@
    <MudTabPanel Text="Appearance" Icon="@Icons.Material.Filled.Palette">
        <MudText Typo="Typo.body2" Color="Color.Default" Class="mb-4">
            Pick a theme and light/dark mode. Changes apply immediately and are saved to your account.
        </MudText>

        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudStack Spacing="2">
                <MudSwitch T="bool" Value="_isDark" ValueChanged="OnDarkChangedAsync"
                           Label="Dark mode" Color="Color.Primary" />
                <MudSwitch T="bool" Value="_tooltipsEnabled" ValueChanged="OnTooltipsChangedAsync"
                           Label="Show helper tooltips"
                           Color="Color.Primary" />
                <MudText Typo="Typo.caption" Color="Color.Default">
                    When on, small <strong>?</strong> icons appear next to fields with extra
                    context. Hover one for a description. Turn off to declutter the UI once
                    you're familiar with the app.
                </MudText>
            </MudStack>
        </MudPaper>

        <MudGrid Spacing="3">
            @foreach (var opt in Catalog.Options)
            {
                var selected = opt.Key == _selectedThemeKey;
                <MudItem xs="12" sm="6" md="4">
                    <MudPaper Class="pa-4" Elevation="@(selected ? 6 : 1)"
                              Style="@($"cursor:pointer;border:2px solid {(selected ? "var(--mud-palette-primary)" : "transparent")};")"
                              @onclick="@(() => SelectThemeAsync(opt.Key))">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@opt.Name</MudText>
                            <MudSpacer />
                            @if (selected)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" />
                            }
                        </MudStack>
                        <MudStack Row="true" Spacing="1">
                            @foreach (var c in opt.Swatches)
                            {
                                <div style="@($"width:2rem;height:2rem;border-radius:4px;background:{c};border:1px solid rgba(0,0,0,0.15);")"></div>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </MudTabPanel>

    @* ------------------------------------------------------------ Avatar *@
    <MudTabPanel Text="Avatar" Icon="@Icons.Material.Filled.AccountCircle">
        <MudText Typo="Typo.body2" Color="Color.Default" Class="mb-4">
            Pick the small circle that represents you across the app. Click again to clear back to initials.
        </MudText>

        <MudGrid Spacing="2">
            @foreach (var av in Avatars.Options)
            {
                var selected = av.Key == _selectedAvatarKey;
                <MudItem>
                    <div style="@($"cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:0.25rem;padding:0.5rem;border-radius:8px;border:2px solid {(selected ? "var(--mud-palette-primary)" : "transparent")};")"
                         @onclick="@(() => SelectAvatarAsync(av.Key))" title="@av.Label">
                        <MudAvatar Size="Size.Large" Style="@($"background:{av.Color};color:white;")">
                            <MudIcon Icon="@av.Icon" Color="Color.Inherit" />
                        </MudAvatar>
                        <MudText Typo="Typo.caption">@av.Label</MudText>
                    </div>
                </MudItem>
            }
        </MudGrid>
    </MudTabPanel>

    @* ------------------------------------------------------------ Password *@
    <MudTabPanel Text="Password" Icon="@Icons.Material.Filled.Lock">
        <MudText Typo="Typo.body2" Color="Color.Default" Class="mb-4">
            Change your password. The new password must meet the same rules used at sign-up
            (minimum 8 characters).
        </MudText>

        <MudPaper Class="pa-4" Elevation="1" Style="max-width:32rem;">
            <MudStack Spacing="3">
                <MudTextField Label="Current password" @bind-Value="_currentPassword"
                              InputType="InputType.Password" Variant="Variant.Outlined"
                              autocomplete="current-password" />
                <MudTextField Label="New password" @bind-Value="_newPassword"
                              InputType="InputType.Password" Variant="Variant.Outlined"
                              autocomplete="new-password"
                              HelperText="At least 8 characters." />
                <MudTextField Label="Confirm new password" @bind-Value="_confirmPassword"
                              InputType="InputType.Password" Variant="Variant.Outlined"
                              autocomplete="new-password" />
                @if (_passwordError is not null) { <MudAlert Severity="Severity.Error">@_passwordError</MudAlert> }
                @if (_passwordSuccess is not null) { <MudAlert Severity="Severity.Success">@_passwordSuccess</MudAlert> }
                <div>
                    <MudButton OnClick="ChangePasswordAsync" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@(!CanSubmitPassword || _passwordSubmitting)">
                        Change password
                    </MudButton>
                </div>
            </MudStack>
        </MudPaper>
    </MudTabPanel>

    @* ------------------------------------------------------------ Security (2FA) *@
    <MudTabPanel Text="Security" Icon="@Icons.Material.Filled.Security">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.body2" Color="Color.Default">
                Add a second factor to your sign-in using a TOTP authenticator app
                (Microsoft Authenticator, Google Authenticator, 1Password, Authy, etc.).
            </MudText>
            <HelpTooltip Text="TOTP (Time-based One-Time Password, RFC 6238) is the standard 30-second rotating-code protocol every authenticator app supports. Once enabled, sign-in becomes two-step: password → 6-digit code. Recovery codes are one-time bypasses for when you lose your device — save them somewhere safe." />
        </MudStack>

        @if (_twoFactor == TwoFactorUiState.Loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_twoFactor == TwoFactorUiState.NotEnrolled)
        {
            <MudPaper Class="pa-4" Elevation="1" Style="max-width:36rem;">
                <MudStack Spacing="3">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Two-factor authentication is <strong>not enabled</strong>.
                    </MudAlert>
                    <MudText Typo="Typo.body2">
                        Click below to generate a new authenticator key. You'll scan a QR code
                        or paste the key into your authenticator app, then enter the 6-digit
                        code it shows to confirm setup.
                    </MudText>
                    <div>
                        <MudButton OnClick="BeginEnrollmentAsync" Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Security"
                                   Disabled="@_twoFactorBusy">
                            Set up authenticator app
                        </MudButton>
                    </div>
                </MudStack>
            </MudPaper>
        }
        else if (_twoFactor == TwoFactorUiState.Enrolling)
        {
            <MudPaper Class="pa-4" Elevation="1" Style="max-width:36rem;">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:600;">1. Scan with your authenticator app</MudText>
                    @if (!string.IsNullOrEmpty(_qrSvg))
                    {
                        <div style="background:white;padding:1rem;border:1px solid rgba(0,0,0,0.12);border-radius:4px;display:inline-block;">
                            @((MarkupString)_qrSvg)
                        </div>
                    }
                    <MudText Typo="Typo.body2" Color="Color.Default">
                        Can't scan? Type this key into your app manually:
                    </MudText>
                    <MudPaper Class="pa-2" Outlined="true"
                              Style="font-family:monospace;letter-spacing:0.1em;font-size:1rem;background:transparent;">
                        @_manualKey
                    </MudPaper>

                    <MudDivider />

                    <MudText Typo="Typo.subtitle1" Style="font-weight:600;">2. Verify the code your app shows</MudText>
                    <MudTextField Label="6-digit code" @bind-Value="_verifyCode"
                                  Variant="Variant.Outlined" Class="mt-2"
                                  Placeholder="000000" MaxLength="8"
                                  HelperText="Codes rotate every 30 seconds." />
                    @if (_twoFactorError is not null) { <MudAlert Severity="Severity.Error">@_twoFactorError</MudAlert> }
                    <MudStack Row="true" Spacing="2">
                        <MudButton OnClick="VerifyAndEnableAsync" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CheckCircle"
                                   Disabled="@(_twoFactorBusy || string.IsNullOrWhiteSpace(_verifyCode))">
                            Verify &amp; enable
                        </MudButton>
                        <MudButton OnClick="CancelEnrollmentAsync" Variant="Variant.Text">Cancel</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
        else if (_twoFactor == TwoFactorUiState.ShowingRecoveryCodes)
        {
            <MudPaper Class="pa-4" Elevation="1" Style="max-width:36rem;">
                <MudStack Spacing="3">
                    <MudAlert Severity="Severity.Success" Dense="true">
                        Two-factor authentication is <strong>now enabled</strong>.
                    </MudAlert>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Recovery codes</MudText>
                        <HelpTooltip Text="These are one-time-use backup codes for signing in when you can't get to your authenticator (lost phone, app uninstalled). Each code works exactly once. Print them, save them in a password manager, anything but plaintext on the same device as the authenticator. You can regenerate the set later from this tab — that invalidates the old codes." />
                    </MudStack>
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        Save these codes somewhere safe — each one can be used <strong>once</strong>
                        to sign in if you lose access to your authenticator app. They will not be
                        shown again.
                    </MudAlert>
                    <MudPaper Outlined="true" Class="pa-3"
                              Style="font-family:monospace;font-size:1rem;line-height:1.6;background:transparent;">
                        @foreach (var rc in _recoveryCodes)
                        {
                            <div>@rc</div>
                        }
                    </MudPaper>
                    <div>
                        <MudButton OnClick="DismissRecoveryCodes" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Done">
                            I've saved them
                        </MudButton>
                    </div>
                </MudStack>
            </MudPaper>
        }
        else if (_twoFactor == TwoFactorUiState.Enrolled)
        {
            <MudPaper Class="pa-4" Elevation="1" Style="max-width:36rem;">
                <MudStack Spacing="3">
                    <MudAlert Severity="Severity.Success" Dense="true">
                        Two-factor authentication is <strong>enabled</strong>.
                    </MudAlert>

                    @* Both actions require a password re-prompt: regenerating
                       codes mints new bypass tokens, disabling removes the
                       second factor entirely. Hijacked sessions shouldn't be
                       able to do either silently. *@
                    <MudStack Row="true" Spacing="2">
                        <MudButton OnClick="@(() => _pendingAction = TwoFactorAction.Regenerate)"
                                   Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   Disabled="@(_pendingAction != TwoFactorAction.None || _twoFactorBusy)">
                            Regenerate recovery codes
                        </MudButton>
                        <MudButton OnClick="@(() => _pendingAction = TwoFactorAction.Disable)"
                                   Variant="Variant.Outlined" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.RemoveModerator"
                                   Disabled="@(_pendingAction != TwoFactorAction.None || _twoFactorBusy)">
                            Disable 2FA
                        </MudButton>
                    </MudStack>

                    @if (_pendingAction != TwoFactorAction.None)
                    {
                        <MudDivider />
                        <MudText Typo="Typo.subtitle2">
                            @(_pendingAction == TwoFactorAction.Disable
                                ? "Confirm: disable two-factor authentication"
                                : "Confirm: regenerate recovery codes")
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Default">
                            @(_pendingAction == TwoFactorAction.Disable
                                ? "After disabling, sign-in requires only your password. Your authenticator key and unused recovery codes will be cleared."
                                : "All ten old codes will be invalidated and replaced. Save the new codes when they appear.")
                        </MudText>
                        <MudTextField Label="Current password" @bind-Value="_actionPassword"
                                      InputType="InputType.Password" Variant="Variant.Outlined"
                                      autocomplete="current-password" />
                        @if (_twoFactorError is not null) { <MudAlert Severity="Severity.Error">@_twoFactorError</MudAlert> }
                        <MudStack Row="true" Spacing="2">
                            @if (_pendingAction == TwoFactorAction.Disable)
                            {
                                <MudButton OnClick="DisableTwoFactorAsync"
                                           Variant="Variant.Filled" Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.RemoveModerator"
                                           Disabled="@(_twoFactorBusy || string.IsNullOrWhiteSpace(_actionPassword))">
                                    Disable 2FA
                                </MudButton>
                            }
                            else
                            {
                                <MudButton OnClick="RegenerateRecoveryCodesAsync"
                                           Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Refresh"
                                           Disabled="@(_twoFactorBusy || string.IsNullOrWhiteSpace(_actionPassword))">
                                    Regenerate codes
                                </MudButton>
                            }
                            <MudButton OnClick="CancelPendingAction" Variant="Variant.Text">Cancel</MudButton>
                        </MudStack>
                    }
                </MudStack>
            </MudPaper>
        }
    </MudTabPanel>
</MudTabs>

@code {
    // ---- Appearance ----
    private string _selectedThemeKey = ThemeCatalog.DefaultKey;
    private bool _isDark;
    private bool _tooltipsEnabled = true;
    private Guid _userId;

    // ---- Avatar ----
    private string? _selectedAvatarKey;

    // ---- Security (2FA) ----
    private enum TwoFactorUiState { Loading, NotEnrolled, Enrolling, ShowingRecoveryCodes, Enrolled }
    private enum TwoFactorAction { None, Disable, Regenerate }
    private TwoFactorUiState _twoFactor = TwoFactorUiState.Loading;
    private TwoFactorAction _pendingAction = TwoFactorAction.None;
    private bool _twoFactorBusy;
    private string? _twoFactorError;
    private string? _manualKey;
    private string? _qrSvg;
    private string _verifyCode = "";
    private string _actionPassword = "";
    private string[] _recoveryCodes = Array.Empty<string>();
    private const string TotpIssuer = "ProjectJA";

    // ---- Password ----
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private string? _passwordError;
    private string? _passwordSuccess;
    private bool _passwordSubmitting;

    private bool CanSubmitPassword =>
        !string.IsNullOrWhiteSpace(_currentPassword)
        && !string.IsNullOrWhiteSpace(_newPassword)
        && !string.IsNullOrWhiteSpace(_confirmPassword);

    protected override async Task OnInitializedAsync()
    {
        // No DB read for the theme here on purpose — MainLayout owns the single
        // per-circuit preference load so the shared scoped AppDbContext isn't
        // hit concurrently. We sync from ThemeState and subscribe for updates.
        ThemeState.Changed += OnThemeStateChanged;
        SyncFromState();

        var authState = await Auth.GetAuthenticationStateAsync();
        Guid.TryParse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), out _userId);
        // Avatar lives outside ThemeState — read it once on init.
        _selectedAvatarKey = await Preferences.GetAvatarKeyAsync(_userId, default);
        _tooltipsEnabled = TooltipState.Enabled;

        // 2FA: NotEnrolled / Enrolled is derived from Identity's TwoFactorEnabled
        // flag. Enrolling / ShowingRecoveryCodes are transient UI states the user
        // can only enter by clicking through this page.
        var user = await Users.FindByIdAsync(_userId.ToString());
        _twoFactor = user is { TwoFactorEnabled: true }
            ? TwoFactorUiState.Enrolled
            : TwoFactorUiState.NotEnrolled;
    }

    private void SyncFromState()
    {
        _selectedThemeKey = Catalog.IsKnown(ThemeState.ThemeKey)
            ? ThemeState.ThemeKey!
            : ThemeCatalog.DefaultKey;
        _isDark = ThemeState.IsDark;
    }

    private void OnThemeStateChanged()
    {
        SyncFromState();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => ThemeState.Changed -= OnThemeStateChanged;

    private async Task SelectThemeAsync(string key)
    {
        _selectedThemeKey = key;
        await ApplyAndSaveThemeAsync();
    }

    private async Task OnDarkChangedAsync(bool isDark)
    {
        _isDark = isDark;
        await ApplyAndSaveThemeAsync();
    }

    private async Task OnTooltipsChangedAsync(bool enabled)
    {
        _tooltipsEnabled = enabled;
        // Live update first so the toggle visibly changes the page; the DB
        // write follows. Cheap enough that a failure here is acceptable —
        // worst case the next sign-in re-reads the old preference.
        TooltipState.Set(enabled);
        await Preferences.SetTooltipsEnabledAsync(_userId, enabled, default);
        Snackbar.Add(enabled ? "Tooltips on." : "Tooltips off.", Severity.Success);
    }

    private async Task ApplyAndSaveThemeAsync()
    {
        ThemeState.Set(_selectedThemeKey, _isDark);
        await Preferences.SetThemeAsync(_userId, _selectedThemeKey, _isDark, default);
        Snackbar.Add("Appearance saved.", Severity.Success);
    }

    private async Task SelectAvatarAsync(string key)
    {
        // Re-clicking the active avatar clears it back to initials.
        var newKey = _selectedAvatarKey == key ? null : key;
        _selectedAvatarKey = newKey;
        await Preferences.SetAvatarKeyAsync(_userId, newKey, default);
        // Publish to circuit-scoped AvatarState so MainLayout's top-right avatar
        // re-renders without a page reload.
        AvatarState.Set(newKey);
        Snackbar.Add(newKey is null ? "Avatar cleared." : "Avatar saved.", Severity.Success);
    }

    private async Task ChangePasswordAsync()
    {
        _passwordError = null;
        _passwordSuccess = null;
        if (_newPassword != _confirmPassword)
        {
            _passwordError = "New password and confirmation don't match.";
            return;
        }

        _passwordSubmitting = true;
        try
        {
            var user = await Users.FindByIdAsync(_userId.ToString());
            if (user is null)
            {
                _passwordError = "Couldn't load your account. Try signing out and back in.";
                return;
            }
            var result = await Users.ChangePasswordAsync(user, _currentPassword, _newPassword);
            if (!result.Succeeded)
            {
                _passwordError = string.Join(" ", result.Errors.Select(e => e.Description));
                return;
            }
            _passwordSuccess = "Password changed.";
            _currentPassword = _newPassword = _confirmPassword = "";
            Snackbar.Add("Password changed.", Severity.Success);
            try { await Notifications.OnPasswordChangedAsync(_userId, default); }
            catch { /* best-effort */ }
        }
        finally
        {
            _passwordSubmitting = false;
        }
    }

    // ---- 2FA enrollment ----

    private async Task BeginEnrollmentAsync()
    {
        _twoFactorError = null;
        _twoFactorBusy = true;
        try
        {
            var user = await Users.FindByIdAsync(_userId.ToString());
            if (user is null) { _twoFactorError = "Couldn't load your account."; return; }

            // ResetAuthenticatorKeyAsync ALWAYS issues a new key (idempotent in
            // the sense that any prior, un-confirmed key is replaced). That's
            // what we want — clicking "Set up" should always give a fresh start.
            await Users.ResetAuthenticatorKeyAsync(user);
            var rawKey = await Users.GetAuthenticatorKeyAsync(user);
            if (string.IsNullOrEmpty(rawKey))
            {
                _twoFactorError = "Couldn't generate an authenticator key.";
                return;
            }

            _manualKey = FormatManualKey(rawKey);
            var email = user.Email ?? user.UserName ?? "user";
            var otpauth = $"otpauth://totp/{Uri.EscapeDataString(TotpIssuer)}:{Uri.EscapeDataString(email)}"
                          + $"?secret={rawKey}&issuer={Uri.EscapeDataString(TotpIssuer)}&digits=6&period=30";
            _qrSvg = GenerateQrSvg(otpauth);
            _verifyCode = "";
            _twoFactor = TwoFactorUiState.Enrolling;
        }
        finally
        {
            _twoFactorBusy = false;
        }
    }

    private async Task VerifyAndEnableAsync()
    {
        _twoFactorError = null;
        _twoFactorBusy = true;
        try
        {
            var user = await Users.FindByIdAsync(_userId.ToString());
            if (user is null) { _twoFactorError = "Couldn't load your account."; return; }

            // Accept the code with whitespace and dashes stripped — different
            // apps copy with varying separators.
            var token = new string((_verifyCode ?? "").Where(char.IsDigit).ToArray());
            var ok = await Users.VerifyTwoFactorTokenAsync(
                user, Users.Options.Tokens.AuthenticatorTokenProvider, token);
            if (!ok)
            {
                _twoFactorError = "That code didn't match. Codes rotate every 30 seconds — try the next one.";
                return;
            }

            var enableResult = await Users.SetTwoFactorEnabledAsync(user, true);
            if (!enableResult.Succeeded)
            {
                _twoFactorError = string.Join(" ", enableResult.Errors.Select(e => e.Description));
                return;
            }

            var codes = await Users.GenerateNewTwoFactorRecoveryCodesAsync(user, 10);
            _recoveryCodes = codes?.ToArray() ?? Array.Empty<string>();
            _twoFactor = TwoFactorUiState.ShowingRecoveryCodes;
            Snackbar.Add("Two-factor authentication enabled.", Severity.Success);
            try { await Notifications.OnTwoFactorEnabledAsync(_userId, default); }
            catch { /* best-effort */ }
        }
        finally
        {
            _twoFactorBusy = false;
        }
    }

    private Task CancelEnrollmentAsync()
    {
        _twoFactorError = null;
        _manualKey = null;
        _qrSvg = null;
        _verifyCode = "";
        _twoFactor = TwoFactorUiState.NotEnrolled;
        return Task.CompletedTask;
    }

    private void DismissRecoveryCodes()
    {
        _recoveryCodes = Array.Empty<string>();
        _twoFactor = TwoFactorUiState.Enrolled;
    }

    private void CancelPendingAction()
    {
        _pendingAction = TwoFactorAction.None;
        _actionPassword = "";
        _twoFactorError = null;
    }

    private async Task DisableTwoFactorAsync()
    {
        _twoFactorError = null;
        _twoFactorBusy = true;
        try
        {
            var user = await Users.FindByIdAsync(_userId.ToString());
            if (user is null) { _twoFactorError = "Couldn't load your account."; return; }
            if (!await Users.CheckPasswordAsync(user, _actionPassword))
            {
                _twoFactorError = "That password is incorrect.";
                return;
            }

            var result = await Users.SetTwoFactorEnabledAsync(user, false);
            if (!result.Succeeded)
            {
                _twoFactorError = string.Join(" ", result.Errors.Select(e => e.Description));
                return;
            }
            // Rotate the authenticator key so the old QR / manual key is dead.
            // Identity has no public Clear; resetting after disable leaves a
            // fresh key that's only meaningful if 2FA is re-enabled later.
            await Users.ResetAuthenticatorKeyAsync(user);

            _pendingAction = TwoFactorAction.None;
            _actionPassword = "";
            _twoFactor = TwoFactorUiState.NotEnrolled;
            Snackbar.Add("Two-factor authentication disabled.", Severity.Success);
            try { await Notifications.OnTwoFactorDisabledAsync(_userId, adminActorId: null, default); }
            catch { /* best-effort */ }
        }
        finally
        {
            _twoFactorBusy = false;
        }
    }

    private async Task RegenerateRecoveryCodesAsync()
    {
        _twoFactorError = null;
        _twoFactorBusy = true;
        try
        {
            var user = await Users.FindByIdAsync(_userId.ToString());
            if (user is null) { _twoFactorError = "Couldn't load your account."; return; }
            if (!await Users.CheckPasswordAsync(user, _actionPassword))
            {
                _twoFactorError = "That password is incorrect.";
                return;
            }

            var codes = await Users.GenerateNewTwoFactorRecoveryCodesAsync(user, 10);
            _recoveryCodes = codes?.ToArray() ?? Array.Empty<string>();
            _pendingAction = TwoFactorAction.None;
            _actionPassword = "";
            _twoFactor = TwoFactorUiState.ShowingRecoveryCodes;
            Snackbar.Add("New recovery codes generated.", Severity.Success);
            try { await Notifications.OnRecoveryCodesRegeneratedAsync(_userId, default); }
            catch { /* best-effort */ }
        }
        finally
        {
            _twoFactorBusy = false;
        }
    }

    // Group the secret in 4-char blocks so it's easier to type into an app.
    private static string FormatManualKey(string raw)
    {
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < raw.Length; i++)
        {
            if (i > 0 && i % 4 == 0) sb.Append(' ');
            sb.Append(char.ToUpperInvariant(raw[i]));
        }
        return sb.ToString();
    }

    // QRCoder's SvgQRCode is dependency-free (no SkiaSharp / System.Drawing).
    // Inline SVG renders straight into the page via MarkupString.
    private static string GenerateQrSvg(string content)
    {
        using var gen = new QRCodeGenerator();
        var data = gen.CreateQrCode(content, QRCodeGenerator.ECCLevel.Q);
        var svg = new SvgQRCode(data);
        return svg.GetGraphic(4);
    }
}
