@page "/issues/{issueId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using ProjectJA.Modules.Issues.Contracts
@using ProjectJA.Modules.Identity.Contracts
@using ProjectJA.Modules.Projects.Contracts
@using ProjectJA.Modules.Projects.Domain
@using ProjectJA.Modules.Workflows.Contracts
@using ProjectJA.Modules.Workflows.Domain
@inject AppDbContext Db
@inject IClock Clock
@inject IAttachmentService Attachments
@inject IIssueLinkService IssueLinks
@inject IUserQueries Users
@inject IProjectQueries Projects
@inject IWorkflowQueries WorkflowsQueries
@inject AuthenticationStateProvider Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(_issue is null ? "Issue" : $"{_projectKey}-{_issue.Number}")</PageTitle>

@if (_issue is null)
{
    <MudText>Loading…</MudText>
}
else
{
    <MudButton Href="@($"/projects/{_issue.ProjectId}")" Variant="Variant.Text"
               StartIcon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="mb-2">Back to project</MudButton>

    <MudText Typo="Typo.h4" GutterBottom="true">
        <span style="font-family:monospace;">@_projectKey-@_issue.Number</span>
        <MudChip T="string" Color="@StatusColor(_state?.Category)" Size="Size.Small" Class="ml-2">@(_state?.Name ?? "—")</MudChip>
    </MudText>
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" GutterBottom="true">Details</MudText>
        @if (!_canWrite)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                You have read-only access to this project — fields can't be edited.
            </MudAlert>
        }
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudTextField Label="Title" @bind-Value="_edit.Title" ReadOnly="@(!_canWrite)"
                              Variant="Variant.Outlined" Required="true" MaxLength="300" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="IssueType" Label="Type" @bind-Value="_edit.Type" ReadOnly="@(!_canWrite)"
                           Variant="Variant.Outlined" Dense="true">
                    @foreach (var t in Enum.GetValues<IssueType>())
                    {
                        <MudSelectItem Value="t">@t</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="int?" Label="Points" @bind-Value="_edit.Points" ReadOnly="@(!_canWrite)"
                                 Variant="Variant.Outlined" Min="0" Max="100" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField Label="Status" Value="@(_state?.Name ?? "—")" ReadOnly="true"
                              Variant="Variant.Outlined"
                              HelperText="Change status on the board or project list." />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?" Label="Assignee" @bind-Value="_edit.AssigneeId" ReadOnly="@(!_canWrite)"
                           Variant="Variant.Outlined" Dense="true" Clearable="true">
                    @foreach (var u in _users)
                    {
                        <MudSelectItem T="Guid?" Value="@u.Id">@u.DisplayName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid" Label="Reporter" @bind-Value="_edit.ReporterId" ReadOnly="@(!_canWrite)"
                           Variant="Variant.Outlined" Dense="true">
                    @foreach (var u in _users)
                    {
                        <MudSelectItem T="Guid" Value="@u.Id">@u.DisplayName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudDatePicker Label="Start date" @bind-Date="_edit.StartDate" ReadOnly="@(!_canWrite)"
                               Variant="Variant.Outlined" Editable="true" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudDatePicker Label="End date" @bind-Date="_edit.EndDate" ReadOnly="@(!_canWrite)"
                               Variant="Variant.Outlined" Editable="true" Clearable="true"
                               HelperText="Must be on or after the start date." />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField T="int" Label="% Complete" @bind-Value="_edit.PercentComplete"
                                 ReadOnly="@(!_canWrite)" Variant="Variant.Outlined"
                                 Min="0" Max="100" Step="5"
                                 HelperText="Auto-set to 100 when transitioned to Done." />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Label="Description" @bind-Value="_edit.Description" ReadOnly="@(!_canWrite)"
                              Variant="Variant.Outlined" Lines="4" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Label="Acceptance Criteria / Definition of Done"
                              @bind-Value="_edit.AcceptanceCriteria" ReadOnly="@(!_canWrite)"
                              Variant="Variant.Outlined" Lines="4"
                              HelperText="What must be true for this work to be considered done." />
            </MudItem>
        </MudGrid>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mt-3">
            @if (_canWrite)
            {
                <MudButton OnClick="SaveAsync" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save">Save details</MudButton>
            }
            <MudText Typo="Typo.caption" Color="Color.Default">
                Created by @CreatorName • @_issue.CreatedAt.ToString("yyyy-MM-dd HH:mm")
            </MudText>
        </MudStack>
        @if (_saveError is not null) { <MudAlert Severity="Severity.Error" Class="mt-2">@_saveError</MudAlert> }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" GutterBottom="true">Blockers</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2">Blocked by</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">
                    Issues that must finish before this one can complete.
                </MudText>
                @if (_links is null)
                {
                    <MudText Class="mt-2">Loading…</MudText>
                }
                else if (_links.BlockedBy.Count == 0)
                {
                    <MudText Class="mt-2" Color="Color.Default">Not blocked.</MudText>
                }
                else
                {
                    <MudList T="IssueLinkSummary" Dense="true" Class="mt-2">
                        @foreach (var b in _links.BlockedBy)
                        {
                            <MudListItem T="IssueLinkSummary" Value="b">
                                <div style="display:flex;align-items:center;gap:0.5rem;">
                                    <MudLink Href="@($"/issues/{b.IssueId}")"
                                             Style="font-family:monospace;flex:0 0 auto;">@_projectKey-@b.Number</MudLink>
                                    <span style="flex:1 1 auto;overflow:hidden;text-overflow:ellipsis;">@b.Title</span>
                                    @if (_canWrite)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="@(() => RemoveBlockerAsync(b.IssueId))" />
                                    }
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                }

                @if (_canWrite)
                {
                    @if (_blockerCandidates.Count == 0)
                    {
                        <MudText Class="mt-3" Color="Color.Default" Typo="Typo.body2">
                            No other issues in this project are available to add as blockers.
                        </MudText>
                    }
                    else
                    {
                        <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2" Class="mt-3">
                            <MudSelect T="Guid?" Label="Add blocker" @bind-Value="_addBlockerSelection"
                                       Variant="Variant.Outlined" Dense="true" Clearable="true">
                                @foreach (var candidate in _blockerCandidates)
                                {
                                    <MudSelectItem T="Guid?" Value="@((Guid?)candidate.IssueId)">
                                        @($"{_projectKey}-{candidate.Number}")  @candidate.Title
                                    </MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton OnClick="AddBlockerAsync" Variant="Variant.Filled" Color="Color.Primary"
                                       Disabled="@(_addBlockerSelection is null)"
                                       StartIcon="@Icons.Material.Filled.Add">Add</MudButton>
                        </MudStack>
                    }
                    @if (_linkError is not null) { <MudAlert Severity="Severity.Error" Class="mt-2">@_linkError</MudAlert> }
                }
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2">Blocks</MudText>
                <MudText Typo="Typo.caption" Color="Color.Default">
                    Issues that wait on this one (managed from the other issue's page).
                </MudText>
                @if (_links is null)
                {
                    <MudText Class="mt-2">Loading…</MudText>
                }
                else if (_links.Blocks.Count == 0)
                {
                    <MudText Class="mt-2" Color="Color.Default">Doesn't block anything.</MudText>
                }
                else
                {
                    <MudList T="IssueLinkSummary" Dense="true" Class="mt-2">
                        @foreach (var b in _links.Blocks)
                        {
                            <MudListItem T="IssueLinkSummary" Value="b">
                                <MudLink Href="@($"/issues/{b.IssueId}")"
                                         Style="font-family:monospace;">@_projectKey-@b.Number</MudLink>
                                &nbsp;@b.Title
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6" GutterBottom="true">Attachments</MudText>

        @if (_canWrite)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <input type="file" id="upload-input" />
            </MudStack>
        }
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert> }

        @if (_attachments is null)
        {
            <MudText>Loading…</MudText>
        }
        else if (_attachments.Count == 0)
        {
            <MudText Color="Color.Default">No attachments.</MudText>
        }
        else
        {
            <MudTable Items="_attachments" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>File</MudTh>
                    <MudTh Style="width:7rem;">Size</MudTh>
                    <MudTh Style="width:12rem;">Uploaded</MudTh>
                    <MudTh Style="width:6rem;"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   OnClick="@(() => DownloadAsync(context.Id))"
                                   StartIcon="@Icons.Material.Filled.Download">@context.FileName</MudButton>
                    </MudTd>
                    <MudTd><MudText Typo="Typo.body2" Color="Color.Default">@FormatSize(context.SizeBytes)</MudText></MudTd>
                    <MudTd><MudText Typo="Typo.body2" Color="Color.Default">@context.UploadedAt.ToString("yyyy-MM-dd HH:mm")</MudText></MudTd>
                    <MudTd>
                        @if (_canWrite)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => DeleteAsync(context.Id))" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
}

@code {
    [Parameter] public Guid IssueId { get; set; }

    private Issue? _issue;
    private string? _projectKey;
    private WorkflowStateView? _state;
    private List<AttachmentSummary>? _attachments;
    private string? _error;
    private string? _saveError;
    private bool _canWrite;
    private DotNetObjectReference<IssueDetail>? _selfRef;

    private IReadOnlyList<UserSummary> _users = Array.Empty<UserSummary>();
    private Dictionary<Guid, string> _userNames = new();
    private EditModel _edit = new();
    private IssueLinksView? _links;
    private List<IssueLinkSummary> _blockerCandidates = new();
    private Guid? _addBlockerSelection;
    private string? _linkError;

    private string CreatorName =>
        _issue is not null && _userNames.TryGetValue(_issue.CreatedById, out var n) ? n : "—";

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        Guid.TryParse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId);
        var projectId = await Db.Issues.AsNoTracking()
            .Where(i => i.Id == IssueId)
            .Select(i => (Guid?)i.ProjectId)
            .FirstOrDefaultAsync();
        var role = projectId is null ? null : await Projects.GetRoleAsync(projectId.Value, userId, default);
        if (role is null)
        {
            Nav.NavigateTo("/projects?denied=1");
            return;
        }
        _canWrite = role.Value.CanWrite();
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only Members+ get the upload input rendered, so only then bind it.
        if (firstRender && _issue is not null && _canWrite)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("projectja.uploads.init", _selfRef, "upload-input", IssueId);
        }
    }

    private async Task ReloadAsync()
    {
        _error = null;
        // Same scoped AppDbContext lives for the whole circuit; clear so we read
        // fresh rows after a save instead of tracked/cached copies.
        Db.ChangeTracker.Clear();
        _issue = await Db.Issues.AsNoTracking().FirstOrDefaultAsync(i => i.Id == IssueId);
        if (_issue is null) return;
        var project = await Db.Projects.AsNoTracking().FirstOrDefaultAsync(p => p.Id == _issue.ProjectId);
        _projectKey = project?.Key ?? "?";
        _state = await WorkflowsQueries.GetStateAsync(_issue.WorkflowStateId, default);
        _users = await Users.ListAllAsync(default);
        _userNames = _users.ToDictionary(u => u.Id, u => u.DisplayName);
        _edit = new EditModel
        {
            Title = _issue.Title,
            Description = _issue.Description,
            Type = _issue.Type,
            Points = _issue.Points,
            AcceptanceCriteria = _issue.AcceptanceCriteria,
            AssigneeId = _issue.AssigneeId,
            ReporterId = _issue.ReporterId,
            StartDate = _issue.StartDate?.LocalDateTime.Date,
            EndDate = _issue.EndDate?.LocalDateTime.Date,
            PercentComplete = _issue.PercentComplete,
        };
        var list = await Attachments.ListAsync(IssueId, default);
        _attachments = list.ToList();

        _links = await IssueLinks.GetLinksAsync(IssueId, default);
        // Pickable blocker candidates: every other issue in this project that
        // isn't already in our BlockedBy list. (The service also rejects
        // self-links and cycles at submit time, so this is just to keep the
        // dropdown small.)
        var blockedByIds = _links.BlockedBy.Select(b => b.IssueId).ToList();
        _blockerCandidates = await Db.Issues.AsNoTracking()
            .Where(i => i.ProjectId == _issue.ProjectId
                        && i.Id != IssueId
                        && !blockedByIds.Contains(i.Id))
            .OrderBy(i => i.Number)
            .Select(i => new IssueLinkSummary(i.Id, i.Number, i.Title))
            .ToListAsync();
        _addBlockerSelection = null;
    }

    private async Task SaveAsync()
    {
        _saveError = null;
        if (!_canWrite)
        {
            _saveError = "Read-only access: only Members and Admins can edit issues.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_edit.Title))
        {
            _saveError = "Title is required.";
            return;
        }

        var tracked = await Db.Issues.FirstOrDefaultAsync(i => i.Id == IssueId);
        if (tracked is null)
        {
            _saveError = "Issue no longer exists.";
            return;
        }

        tracked.Edit(_edit.Title, _edit.Description, Clock.UtcNow);
        tracked.Reclassify(_edit.Type, _edit.Points, _edit.AcceptanceCriteria, Clock.UtcNow);
        tracked.Assign(_edit.AssigneeId, Clock.UtcNow);
        if (_edit.ReporterId != Guid.Empty)
            tracked.SetReporter(_edit.ReporterId, Clock.UtcNow);
        try
        {
            tracked.SetSchedule(
                _edit.StartDate is { } sd ? new DateTimeOffset(sd, TimeSpan.Zero) : null,
                _edit.EndDate is { } ed ? new DateTimeOffset(ed, TimeSpan.Zero) : null,
                Clock.UtcNow);
            tracked.SetPercentComplete(Math.Clamp(_edit.PercentComplete, 0, 100), Clock.UtcNow);
        }
        catch (InvalidOperationException ex)
        {
            _saveError = ex.Message;
            return;
        }
        await Db.SaveChangesAsync();

        await ReloadAsync();
        Snackbar.Add("Issue details saved.", Severity.Success);
    }

    private async Task AddBlockerAsync()
    {
        _linkError = null;
        if (!_canWrite || _addBlockerSelection is not { } blockerId) return;
        var outcome = await IssueLinks.AddBlockerAsync(IssueId, blockerId, Guid.Empty, default);
        // Guid.Empty is fine here for actingUserId — the service only stores
        // it for audit, and we currently don't expose user identity to the
        // page-level link service caller. (Refactor if/when audit needs it.)
        _linkError = outcome switch
        {
            AddBlockerOutcome.Added => null,
            AddBlockerOutcome.SelfLink => "An issue cannot block itself.",
            AddBlockerOutcome.NotFound => "Selected issue no longer exists.",
            AddBlockerOutcome.CrossProject => "Blocker must belong to the same project.",
            AddBlockerOutcome.Duplicate => "That issue is already a blocker.",
            AddBlockerOutcome.Cycle => "Adding this blocker would create a cycle.",
            _ => "Unable to add blocker.",
        };
        if (_linkError is null)
        {
            await ReloadAsync();
            Snackbar.Add("Blocker added.", Severity.Success);
        }
    }

    private async Task RemoveBlockerAsync(Guid blockerId)
    {
        if (!_canWrite) return;
        if (await IssueLinks.RemoveBlockerAsync(IssueId, blockerId, default))
        {
            await ReloadAsync();
            Snackbar.Add("Blocker removed.", Severity.Success);
        }
    }

    private sealed class EditModel
    {
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public IssueType Type { get; set; } = IssueType.Task;
        public int? Points { get; set; }
        public string? AcceptanceCriteria { get; set; }
        public Guid? AssigneeId { get; set; }
        public Guid ReporterId { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public int PercentComplete { get; set; }
    }

    [JSInvokable]
    public async Task OnUploadComplete(Guid attachmentId)
    {
        _error = null;
        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnUploadError(string message)
    {
        _error = $"Upload failed: {message}";
        return InvokeAsync(StateHasChanged);
    }

    private async Task DownloadAsync(Guid attachmentId)
    {
        var url = await Attachments.GetDownloadUrlAsync(attachmentId, TimeSpan.FromMinutes(15), default);
        if (url is null) return;
        await JS.InvokeVoidAsync("open", url.ToString(), "_blank");
    }

    private async Task DeleteAsync(Guid attachmentId)
    {
        if (!_canWrite) return;
        if (await Attachments.DeleteAsync(attachmentId, default))
            await ReloadAsync();
    }

    public ValueTask DisposeAsync()
    {
        _selfRef?.Dispose();
        return ValueTask.CompletedTask;
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes / 1024.0 / 1024.0:0.##} MB";
    }

    private static Color StatusColor(WorkflowStateCategory? c) => c switch
    {
        WorkflowStateCategory.Open => Color.Default,
        WorkflowStateCategory.InProgress => Color.Warning,
        WorkflowStateCategory.Done => Color.Success,
        _ => Color.Default,
    };
}
