@page "/projects/{projectId:guid}/board"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using ProjectJA.Host.Hubs
@using ProjectJA.Host.Components.Dialogs
@using ProjectJA.Host.Theming
@using ProjectJA.SharedKernel.Tenancy
@using System.Security.Claims
@using ProjectJA.Modules.Identity.Contracts
@using ProjectJA.Modules.Projects.Contracts
@using ProjectJA.Modules.Projects.Domain
@using ProjectJA.Modules.Workflows.Contracts
@using ProjectJA.Modules.Workflows.Domain
@using ProjectJA.Modules.Issues.Contracts
@inject AppDbContext Db
@inject IClock Clock
@inject ITenantContext Tenant
@inject BoardEventStream EventStream
@inject IDialogService DialogService
@inject ThemeState ThemeState
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@inject IProjectQueries Projects
@inject ISprintQueries SprintsQueries
@inject ProjectJA.SharedKernel.Notifications.INotificationService Notifications
@inject IUserQueries Users
@inject ITagManagementService TagsService
@inject IWorkflowQueries WorkflowsQueries
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(_project is null ? "Board" : $"{_project.Key} board")</PageTitle>

@if (_project is null)
{
    <MudText>Loading…</MudText>
}
else
{
    <MudButton Href="@($"/projects/{ProjectId}")" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="mb-2">Back to project</MudButton>

    <MudText Typo="Typo.h4" GutterBottom="true">
        <span style="font-family:monospace;">@_project.Key</span> — @_project.Name
        <span style="font-size:1rem;color:#888;margin-left:0.5rem;">board</span>
    </MudText>

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
        <MudSelect T="string" Label="Show" @bind-Value="_filter" Dense="true" Margin="Margin.Dense"
                   Style="min-width:18rem;" Variant="Variant.Outlined">
            <MudSelectItem Value="@("all")">All issues</MudSelectItem>
            <MudSelectItem Value="@("backlog")">Backlog only</MudSelectItem>
            @foreach (var s in _sprints.Where(x => x.Status != SprintStatus.Completed))
            {
                <MudSelectItem Value="@s.Id.ToString()">@s.Name (@s.Status)</MudSelectItem>
            }
        </MudSelect>
        <MudText Typo="Typo.caption" Color="Color.Default">
            @ApplyFilter(_issues).Count() of @_issues.Count issues
        </MudText>
    </MudStack>

    <MudGrid Spacing="2">
        @foreach (var col in _workflow?.States.OrderBy(s => s.Order) ?? Enumerable.Empty<WorkflowStateView>())
        {
            <MudItem xs="12" sm="@(12 / Math.Max(1, _workflow!.States.Count))">
                <div class="board-column"
                     data-state-id="@col.Id"
                     style="@($"min-height:24rem;background:{ColumnBackground(col.Category)};border:1px solid {LaneBorder()};border-radius:6px;padding:0.5rem;")">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:600;" Class="px-1 pb-2">@col.Name</MudText>

                    @foreach (var issue in IssuesIn(col.Id))
                    {
                        <div draggable="@(_canWrite ? "true" : "false")"
                             data-issue-id="@issue.Id"
                             @key="issue.Id"
                             class="board-card"
                             title="@(_canWrite ? "Drag to move · double-click to edit" : "Double-click to view")"
                             @ondblclick="@(() => OpenEditAsync(issue.Id))"
                             style="@($"cursor:grab;background:{CardBackground()};border:1px solid {CardBorder()};border-radius:4px;padding:0.5rem 0.75rem;margin-bottom:0.5rem;")">
                            <div style="display:flex;align-items:flex-start;gap:0.5rem;">
                                <div style="flex:1 1 auto;min-width:0;">
                                    <div style="@($"font-family:monospace;font-size:0.75rem;color:{CardKeyColor()};")">@_project.Key-@issue.Number</div>
                                    <div style="@($"font-size:0.9rem;color:{CardTitleColor()};")">@issue.Title</div>
                                </div>
                                @if (issue.AssigneeId is { } assignee && _userById.TryGetValue(assignee, out var au))
                                {
                                    <div style="flex:0 0 auto;">
                                        <UserAvatar AvatarKey="@au.AvatarKey" DisplayName="@au.DisplayName" Size="Size.Small" />
                                    </div>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(issue.Description))
                            {
                                <div style="@($"font-size:0.8rem;color:{CardDescColor()};margin-top:0.15rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;")">@issue.Description</div>
                            }
                            @{
                                var hasSprint = issue.SprintId is { } sid && _sprintNames.TryGetValue(sid, out var sname);
                                var anyChip = issue.Priority != IssuePriority.None || issue.Labels.Count > 0 || hasSprint;
                            }
                            @if (anyChip)
                            {
                                <div style="margin-top:0.35rem;display:flex;flex-wrap:wrap;gap:0.25rem;align-items:center;">
                                    @if (issue.Priority != IssuePriority.None)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="@PriorityColor(issue.Priority)">@issue.Priority</MudChip>
                                    }
                                    @if (issue.SprintId is { } sid2 && _sprintNames.TryGetValue(sid2, out var sname2))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary"
                                                 Icon="@Icons.Material.Filled.Loop">@sname2</MudChip>
                                    }
                                    @foreach (var lbl in issue.Labels)
                                    {
                                        <TagChip Tag="@lbl" Styles="_tagStyles" />
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </MudItem>
        }
    </MudGrid>
}

<style>
    .board-card-dragging { opacity: 0.5; }
    .board-column-hover { box-shadow: inset 0 0 0 2px #594ae2; }
</style>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private Project? _project;
    private bool _canWrite;
    private List<Issue> _issues = new();
    private WorkflowView? _workflow;
    private IReadOnlyList<SprintSummary> _sprints = Array.Empty<SprintSummary>();
    private Dictionary<Guid, string> _sprintNames = new();
    private IReadOnlyDictionary<string, string> _tagStyles = new Dictionary<string, string>();
    private Dictionary<Guid, UserSummary> _userById = new();
    private Guid _currentUserId;
    // Filter value conventions: "all" | "backlog" | "<sprint-guid>".
    private string _filter = "all";
    private IDisposable? _subscription;
    private DotNetObjectReference<Board>? _selfRef;
    private string? _groupName;

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        Guid.TryParse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), out _currentUserId);
        var role = await Projects.GetRoleAsync(ProjectId, _currentUserId, default);
        if (role is null)
        {
            Nav.NavigateTo("/projects?denied=1");
            return;
        }
        _canWrite = role.Value.CanWrite();
        await ReloadAsync();
        _groupName = $"tenant:{Tenant.Current.Value:N}:project:{ProjectId:N}";
        _subscription = EventStream.Subscribe(_groupName, HandleEventAsync);
        // Re-render lane colours when the user toggles dark mode while on the board.
        // (ThemeState is loaded by MainLayout post-render, so this also fires once
        //  the saved preference resolves.)
        ThemeState.Changed += OnThemeChanged;
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_project is null) return;
        // Re-init on every render so freshly rendered cards/columns (after drops, reloads,
        // or remote IssueMoved events) get their drag-drop listeners. The JS guards
        // against double-binding via data-dnd-bound.
        _selfRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("projectja.board.init", _selfRef);
    }

    private async Task ReloadAsync()
    {
        Db.ChangeTracker.Clear();
        _project = await Db.Projects.AsNoTracking().FirstOrDefaultAsync(p => p.Id == ProjectId);
        if (_project is null) return;
        _issues = await Db.Issues.AsNoTracking()
            .Where(i => i.ProjectId == ProjectId)
            .OrderBy(i => i.Number)
            .ToListAsync();
        _workflow = await WorkflowsQueries.GetForProjectAsync(ProjectId, default);
        _sprints = await SprintsQueries.ListForProjectAsync(ProjectId, default);
        _sprintNames = _sprints.ToDictionary(s => s.Id, s => s.Name);
        _tagStyles = await TagsService.GetStylesAsync(ProjectId, default);
        // Used to render assignee avatars on cards. Org-wide pool is small in
        // practice; one query per board reload is fine.
        var users = await Users.ListAllAsync(default);
        _userById = users.ToDictionary(u => u.Id);
        // Default filter: the active sprint if there is one — that's almost
        // always what users want to see when they hit the board.
        if (_filter == "all")
        {
            var active = _sprints.FirstOrDefault(s => s.Status == SprintStatus.Active);
            if (active is not null) _filter = active.Id.ToString();
        }
    }

    private IEnumerable<Issue> ApplyFilter(IEnumerable<Issue> items) => _filter switch
    {
        "all" => items,
        "backlog" => items.Where(i => i.SprintId is null),
        var s when Guid.TryParse(s, out var sid) => items.Where(i => i.SprintId == sid),
        _ => items,
    };

    private IEnumerable<Issue> IssuesIn(Guid stateId) =>
        ApplyFilter(_issues).Where(i => i.WorkflowStateId == stateId);

    // Lane tints by Category — the workflow can have any number of states with
    // custom names, but they always fall into Open / InProgress / Done buckets,
    // so the tint cue stays consistent across projects. (Light = near-white;
    // dark = muted dark, since a literal darken of near-white still glares.)
    private string ColumnBackground(WorkflowStateCategory cat) => ThemeState.IsDark
        ? cat switch
        {
            WorkflowStateCategory.Open => "#26262e",
            WorkflowStateCategory.InProgress => "#2e2a1c",
            WorkflowStateCategory.Done => "#1e2b22",
            _ => "#26262e",
        }
        : cat switch
        {
            WorkflowStateCategory.Open => "#fafafa",
            WorkflowStateCategory.InProgress => "#fff8e1",
            WorkflowStateCategory.Done => "#e8f5e9",
            _ => "#fafafa",
        };

    private string LaneBorder() => ThemeState.IsDark ? "#3a3a44" : "#e0e0e0";

    // Cards: light = white on tinted lanes; dark = a surface a touch lighter
    // than the dark lanes so cards still "pop", with readable muted text.
    private static Color PriorityColor(IssuePriority p) => p switch
    {
        IssuePriority.Critical => Color.Error,
        IssuePriority.High => Color.Warning,
        IssuePriority.Medium => Color.Info,
        _ => Color.Default,
    };

    private string CardBackground() => ThemeState.IsDark ? "#30303a" : "white";
    private string CardBorder() => ThemeState.IsDark ? "#44444f" : "#ddd";
    private string CardKeyColor() => ThemeState.IsDark ? "#9a9aa5" : "#888";
    private string CardTitleColor() => ThemeState.IsDark ? "#e6e6ea" : "inherit";
    private string CardDescColor() => ThemeState.IsDark ? "#a0a0ab" : "#6a6a6a";

    [JSInvokable]
    public async Task OnCardDropped(string issueId, string stateId)
    {
        // Defense-in-depth: cards aren't draggable for Viewers, but a tampered
        // client could still invoke this. The API PATCH also re-checks the role.
        if (!_canWrite) return;
        if (!Guid.TryParse(issueId, out var iid)) return;
        if (!Guid.TryParse(stateId, out var sid)) return;
        // Target state must belong to this project's workflow.
        if (_workflow?.States.Any(s => s.Id == sid) != true) return;

        var issue = await Db.Issues.FirstOrDefaultAsync(i => i.Id == iid);
        if (issue is null || issue.WorkflowStateId == sid) return;

        // Honor the workflow's transition matrix. The API PATCH enforces this
        // too; the UI check just gives the user immediate feedback before the
        // round trip.
        if (_workflow is not null && !_workflow.IsTransitionAllowed(issue.WorkflowStateId, sid))
        {
            var from = _workflow.States.FirstOrDefault(s => s.Id == issue.WorkflowStateId)?.Name ?? "?";
            var to = _workflow.States.FirstOrDefault(s => s.Id == sid)?.Name ?? "?";
            Snackbar.Add($"Workflow doesn't allow moving from \"{from}\" to \"{to}\".", Severity.Warning);
            await InvokeAsync(StateHasChanged);
            return;
        }

        issue.Transition(sid, Clock.UtcNow);
        await Db.SaveChangesAsync();

        try
        {
            var doneCategory = _workflow?.States.FirstOrDefault(s => s.Id == sid)?.Category
                               == WorkflowStateCategory.Done;
            await Notifications.OnIssueTransitionedAsync(issue.Id, doneCategory, _currentUserId, default);
        }
        catch { /* best-effort */ }

        if (_groupName is not null)
        {
            await EventStream.PublishAsync(
                _groupName,
                "IssueMoved",
                new { issueId = issue.Id, projectId = issue.ProjectId, workflowStateId = issue.WorkflowStateId });
        }

        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenEditAsync(Guid issueId)
    {
        var parameters = new DialogParameters<IssueEditDialog> { { x => x.IssueId, issueId } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<IssueEditDialog>("Edit issue", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        await ReloadAsync();
        await InvokeAsync(StateHasChanged);

        // Mirror the drop path: tell other clients/boards to refresh. The edit
        // may have changed status (lane), so republish the issue's current state.
        if (_groupName is not null)
        {
            var edited = _issues.FirstOrDefault(i => i.Id == issueId);
            if (edited is not null)
                await EventStream.PublishAsync(
                    _groupName,
                    "IssueMoved",
                    new { issueId = edited.Id, projectId = edited.ProjectId, workflowStateId = edited.WorkflowStateId });
        }
    }

    private async Task HandleEventAsync(string eventName, object payload)
    {
        if (eventName != "IssueMoved") return;
        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public ValueTask DisposeAsync()
    {
        ThemeState.Changed -= OnThemeChanged;
        _subscription?.Dispose();
        _selfRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}
