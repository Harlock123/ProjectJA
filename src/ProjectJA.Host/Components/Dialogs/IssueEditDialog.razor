@using System.Security.Claims
@using ProjectJA.Modules.Identity.Contracts
@using ProjectJA.Modules.Issues.Contracts
@using ProjectJA.Modules.Projects.Contracts
@using ProjectJA.Modules.Projects.Domain
@using ProjectJA.Host.Hubs
@using ProjectJA.SharedKernel.Realtime
@using ProjectJA.SharedKernel.Tenancy
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IClock Clock
@inject IProjectQueries Projects
@inject ISprintQueries SprintsQueries
@inject IUserQueries Users
@inject IAttachmentService Attachments
@inject AuthenticationStateProvider Auth
@inject IRealtimeNotifier Realtime
@inject BoardEventStream EventStream
@inject ITenantContext Tenant
@inject IJSRuntime JS
@implements IAsyncDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(_loaded && _issue is not null ? $"{_projectKey}-{_issue.Number}" : "Issue")
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (!_loaded)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_issue is null)
        {
            <MudAlert Severity="Severity.Error">Issue not found.</MudAlert>
        }
        else
        {
            <MudTabs Elevation="0" Rounded="true" KeepPanelsAlive="true" Style="min-width:34rem;">
                <MudTabPanel Text="Details">
                    <MudStack Spacing="3" Class="pt-3">
                        @if (!_canWrite)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                Read-only access — you can view this issue but not change it.
                            </MudAlert>
                        }
                        <MudTextField Label="Title" @bind-Value="_edit.Title" ReadOnly="@(!_canWrite)"
                                      Variant="Variant.Outlined" Required="true" MaxLength="300" />
                        <MudStack Row="true" Spacing="2">
                            <MudSelect T="IssueType" Label="Type" @bind-Value="_edit.Type" ReadOnly="@(!_canWrite)"
                                       Variant="Variant.Outlined" Dense="true">
                                @foreach (var t in Enum.GetValues<IssueType>())
                                {
                                    <MudSelectItem Value="t">@t</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="IssueStatus" Label="Status" @bind-Value="_edit.Status" ReadOnly="@(!_canWrite)"
                                       Variant="Variant.Outlined" Dense="true">
                                @foreach (var s in Enum.GetValues<IssueStatus>())
                                {
                                    <MudSelectItem Value="s">@s</MudSelectItem>
                                }
                            </MudSelect>
                            <MudNumericField T="int?" Label="Points" @bind-Value="_edit.Points" ReadOnly="@(!_canWrite)"
                                             Variant="Variant.Outlined" Min="0" Max="100" />
                        </MudStack>
                        <MudStack Row="true" Spacing="2">
                            <MudSelect T="Guid?" Label="Assignee" @bind-Value="_edit.AssigneeId" ReadOnly="@(!_canWrite)"
                                       Variant="Variant.Outlined" Dense="true" Clearable="true">
                                @foreach (var u in _users)
                                {
                                    <MudSelectItem T="Guid?" Value="@u.Id">@u.DisplayName</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="Guid" Label="Reporter" @bind-Value="_edit.ReporterId" ReadOnly="@(!_canWrite)"
                                       Variant="Variant.Outlined" Dense="true">
                                @foreach (var u in _users)
                                {
                                    <MudSelectItem T="Guid" Value="@u.Id">@u.DisplayName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudStack>
                        <MudStack Row="true" Spacing="2">
                            <MudSelect T="IssuePriority" Label="Priority" @bind-Value="_edit.Priority" ReadOnly="@(!_canWrite)"
                                       Variant="Variant.Outlined" Dense="true">
                                @foreach (var p in Enum.GetValues<IssuePriority>())
                                {
                                    <MudSelectItem Value="p">@p</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField Label="Labels" @bind-Value="_edit.Labels" ReadOnly="@(!_canWrite)"
                                          Placeholder="comma-separated"
                                          HelperText="Free-text tags, comma-separated."
                                          Variant="Variant.Outlined" />
                        </MudStack>
                        @{
                            // Always include the currently-assigned sprint (even Completed) so the
                            // dropdown displays the current value; Completed ones aren't valid moves.
                            var sprintOptions = _sprints.Where(s => s.Status != SprintStatus.Completed || s.Id == _issue!.SprintId).ToList();
                        }
                        <MudSelect T="Guid?" Label="Sprint" @bind-Value="_edit.SprintId" ReadOnly="@(!_isAdmin)"
                                   Variant="Variant.Outlined" Dense="true" Clearable="@_isAdmin"
                                   HelperText="@( _isAdmin ? "Backlog if empty. Only Planned/Active sprints can be assigned." : "Only Admins can change an issue's sprint." )">
                            @foreach (var s in sprintOptions)
                            {
                                <MudSelectItem T="Guid?" Value="@s.Id">@s.Name (@s.Status)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField Label="Description" @bind-Value="_edit.Description" ReadOnly="@(!_canWrite)"
                                      Variant="Variant.Outlined" Lines="3" />
                        <MudTextField Label="Acceptance Criteria / Definition of Done"
                                      @bind-Value="_edit.AcceptanceCriteria" ReadOnly="@(!_canWrite)"
                                      Variant="Variant.Outlined" Lines="3" />
                        @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
                    </MudStack>
                </MudTabPanel>

                <MudTabPanel Text="@($"Attachments ({_attachments?.Count ?? 0})")">
                    <MudStack Spacing="2" Class="pt-3">
                        @if (_canWrite)
                        {
                            <input type="file" id="@_uploadInputId" />
                        }
                        @if (_attachError is not null) { <MudAlert Severity="Severity.Error">@_attachError</MudAlert> }
                        @if (_attachments is null)
                        {
                            <MudText>Loading…</MudText>
                        }
                        else if (_attachments.Count == 0)
                        {
                            <MudText Color="Color.Default">No attachments.</MudText>
                        }
                        else
                        {
                            <MudTable Items="_attachments" Hover="true" Dense="true">
                                <HeaderContent>
                                    <MudTh>File</MudTh>
                                    <MudTh Style="width:6rem;">Size</MudTh>
                                    <MudTh Style="width:11rem;">Uploaded</MudTh>
                                    <MudTh Style="width:5rem;"></MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                                   OnClick="@(() => DownloadAsync(context.Id))"
                                                   StartIcon="@Icons.Material.Filled.Download">@context.FileName</MudButton>
                                    </MudTd>
                                    <MudTd><MudText Typo="Typo.body2" Color="Color.Default">@FormatSize(context.SizeBytes)</MudText></MudTd>
                                    <MudTd><MudText Typo="Typo.body2" Color="Color.Default">@context.UploadedAt.ToString("yyyy-MM-dd HH:mm")</MudText></MudTd>
                                    <MudTd>
                                        @if (_canWrite)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                           OnClick="@(() => DeleteAttachmentAsync(context.Id))" />
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudStack>
                </MudTabPanel>

                <MudTabPanel Text="@($"Comments ({_comments.Count})")">
                    <MudStack Spacing="3" Class="pt-3">
                        @if (_comments.Count == 0)
                        {
                            <MudText Color="Color.Default">No comments yet.</MudText>
                        }
                        else
                        {
                            <div style="max-height:30vh;overflow-y:auto;padding-right:0.25rem;">
                                <MudStack Spacing="2">
                                    @foreach (var c in _comments)
                                    {
                                        var mine = _canWrite && c.AuthorId == _currentUserId;
                                        <MudPaper @key="c.Id" Class="pa-2" Outlined="true"
                                                  Style="@(mine && _editingCommentId != c.Id ? "cursor:pointer;" : null)"
                                                  title="@(mine && _editingCommentId != c.Id ? "Double-click to edit or delete" : null)"
                                                  @ondblclick="@(() => OnCommentDblClick(c))">
                                            <MudText Typo="Typo.caption" Color="Color.Default">
                                                <strong>@AuthorName(c.AuthorId)</strong> · @c.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                            </MudText>
                                            @if (_editingCommentId == c.Id)
                                            {
                                                <MudTextField @bind-Value="_editBody" Variant="Variant.Outlined"
                                                              Lines="3" MaxLength="8000" Immediate="true" Class="mt-1" />
                                                <MudStack Row="true" Spacing="2" Class="mt-1" AlignItems="AlignItems.Center">
                                                    <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                                               OnClick="SaveEditCommentAsync"
                                                               Disabled="@string.IsNullOrWhiteSpace(_editBody)">Save</MudButton>
                                                    <MudButton Size="Size.Small" OnClick="CancelEditComment">Cancel</MudButton>
                                                    <MudSpacer />
                                                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                                                               StartIcon="@Icons.Material.Filled.Delete"
                                                               OnClick="@(() => DeleteCommentAsync(c.Id))">Delete</MudButton>
                                                </MudStack>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@c.Body</MudText>
                                            }
                                        </MudPaper>
                                    }
                                </MudStack>
                            </div>
                        }
                        @if (_canWrite)
                        {
                            <MudTextField @bind-Value="_newComment" Label="Add a comment"
                                          Variant="Variant.Outlined" Lines="3" MaxLength="8000"
                                          Immediate="true" />
                            @if (_commentError is not null) { <MudAlert Severity="Severity.Error">@_commentError</MudAlert> }
                            <div>
                                <MudButton OnClick="AddCommentAsync" Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Send"
                                           Disabled="@string.IsNullOrWhiteSpace(_newComment)">Comment</MudButton>
                            </div>
                        }
                    </MudStack>
                </MudTabPanel>
            </MudTabs>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Close</MudButton>
        @if (_canWrite)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="SaveAsync" Disabled="@(!_loaded || _issue is null)">Save details</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid IssueId { get; set; }

    private bool _loaded;
    private bool _jsInited;
    private bool _changed;
    private bool _canWrite;
    private bool _isAdmin;
    private IReadOnlyList<SprintSummary> _sprints = Array.Empty<SprintSummary>();
    private Issue? _issue;
    private string? _projectKey;
    private string? _error;
    private string? _commentError;
    private string? _attachError;
    private Guid _currentUserId;
    private Guid? _editingCommentId;
    private string _editBody = "";
    private string _uploadInputId = "";
    private string _newComment = "";
    private IReadOnlyList<UserSummary> _users = Array.Empty<UserSummary>();
    private Dictionary<Guid, string> _userNames = new();
    private List<AttachmentSummary>? _attachments;
    private List<Comment> _comments = new();
    private EditModel _edit = new();
    private DotNetObjectReference<IssueEditDialog>? _selfRef;
    private string? _groupName;
    private IDisposable? _rtSubscription;
    // Every DB op uses a fresh short-lived context from the factory (isolated
    // change tracker), NOT the shared circuit-scoped one. That's what makes the
    // identical API code correct; reusing the shared context here let realtime
    // reloads / the board / prior failed saves corrupt change detection (a new
    // owned Comment was misclassified Modified → "0 rows affected").
    private bool _ownPublishInFlight;

    protected override async Task OnInitializedAsync()
    {
        _uploadInputId = $"dlg-upload-{IssueId:N}";

        var authState = await Auth.GetAuthenticationStateAsync();
        Guid.TryParse(authState.User.FindFirstValue(ClaimTypes.NameIdentifier), out _currentUserId);

        try
        {
            await using var db = DbFactory.CreateDbContext();
            _issue = await db.Issues.AsNoTracking()
                .Include(i => i.Comments)
                .FirstOrDefaultAsync(i => i.Id == IssueId);
            if (_issue is not null)
            {
                var project = await db.Projects.AsNoTracking()
                    .FirstOrDefaultAsync(p => p.Id == _issue.ProjectId);
                _projectKey = project?.Key ?? "?";
                var role = await Projects.GetRoleAsync(_issue.ProjectId, _currentUserId, default);
                _canWrite = role?.CanWrite() == true;
                _isAdmin = role == ProjectRole.Admin;
                _sprints = await SprintsQueries.ListForProjectAsync(_issue.ProjectId, default);
                _users = await Users.ListAllAsync(default);
                _userNames = _users.ToDictionary(u => u.Id, u => u.DisplayName);
                _comments = _issue.Comments.OrderByDescending(c => c.CreatedAt).ToList();
                _edit = new EditModel
                {
                    Title = _issue.Title,
                    Description = _issue.Description,
                    Type = _issue.Type,
                    Status = _issue.Status,
                    Priority = _issue.Priority,
                    Points = _issue.Points,
                    AcceptanceCriteria = _issue.AcceptanceCriteria,
                    AssigneeId = _issue.AssigneeId,
                    ReporterId = _issue.ReporterId,
                    Labels = string.Join(", ", _issue.Labels),
                    SprintId = _issue.SprintId,
                };
                var attachments = await Attachments.ListAsync(IssueId, default);
                _attachments = attachments.ToList();
            }
        }
        catch (Exception ex)
        {
            _error = $"Couldn't load this issue: {ex.Message}";
        }

        // Realtime is best-effort: if the tenant isn't resolved for this scope
        // or subscription fails, the dialog still works fully (no live updates).
        if (_issue is not null)
        {
            try
            {
                _groupName = $"tenant:{Tenant.Current.Value:N}:project:{_issue.ProjectId:N}";
                _rtSubscription = EventStream.Subscribe(_groupName, OnRealtimeAsync);
            }
            catch
            {
                _groupName = null;
            }
        }
        _loaded = true;
    }

    private async Task OnRealtimeAsync(string eventName, object payload)
    {
        // Skip our own echo (redundant — the local action already reloaded).
        if (eventName != "CommentsChanged" || _ownPublishInFlight) return;
        try
        {
            await ReloadCommentsCoreAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // A transient realtime refresh must never fault the circuit.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Viewers don't get the upload input rendered — nothing to bind.
        if (_jsInited || !_loaded || _issue is null || !_canWrite) return;
        _jsInited = true;
        _selfRef = DotNetObjectReference.Create(this);
        // Panels are kept alive, so the file input is in the DOM even when the
        // Attachments tab isn't active. JS guards against double-binding.
        await JS.InvokeVoidAsync("projectja.uploads.init", _selfRef, _uploadInputId, IssueId);
    }

    private string AuthorName(Guid id) =>
        _userNames.TryGetValue(id, out var n) ? n : "(unknown)";

    private async Task SaveAsync()
    {
        _error = null;
        if (!_canWrite)
        {
            _error = "Read-only access: only Members and Admins can edit issues.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_edit.Title))
        {
            _error = "Title is required.";
            return;
        }

        try
        {
            await using var db = DbFactory.CreateDbContext();
            var tracked = await db.Issues.FirstOrDefaultAsync(i => i.Id == IssueId);
            if (tracked is null)
            {
                _error = "Issue no longer exists.";
                return;
            }

            tracked.Edit(_edit.Title, _edit.Description, Clock.UtcNow);
            tracked.Reclassify(_edit.Type, _edit.Points, _edit.AcceptanceCriteria, Clock.UtcNow);
            tracked.SetPriority(_edit.Priority, Clock.UtcNow);
            tracked.SetLabels(SplitLabels(_edit.Labels), Clock.UtcNow);
            tracked.Assign(_edit.AssigneeId, Clock.UtcNow);
            if (_edit.ReporterId != Guid.Empty)
                tracked.SetReporter(_edit.ReporterId, Clock.UtcNow);
            if (tracked.Status != _edit.Status)
                tracked.Transition(_edit.Status, Clock.UtcNow);
            // Sprint change is Admin-only and only the changed value matters; reject
            // moves into a Completed sprint (the dropdown already filters, but a
            // tampered circuit could submit one).
            if (_isAdmin && tracked.SprintId != _edit.SprintId)
            {
                if (_edit.SprintId is { } sid &&
                    _sprints.FirstOrDefault(s => s.Id == sid)?.Status == SprintStatus.Completed)
                {
                    _error = "Can't assign an issue to a completed sprint.";
                    return;
                }
                tracked.AssignToSprint(_edit.SprintId, Clock.UtcNow);
            }
            await db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            _error = $"Save failed: {ex.Message}";
            return;
        }

        MudDialog.Close(DialogResult.Ok(IssueId));
    }

    // Close returns Ok if attachments/comments changed underlying data so the
    // caller can refresh; otherwise a plain cancel.
    private void Cancel()
    {
        if (_changed) MudDialog.Close(DialogResult.Ok(IssueId));
        else MudDialog.Cancel();
    }

    private async Task AddCommentAsync()
    {
        _commentError = null;
        if (!_canWrite)
        {
            _commentError = "Read-only access: only Members and Admins can comment.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_newComment)) return;
        if (_currentUserId == Guid.Empty)
        {
            _commentError = "Couldn't resolve your account — reload the page and try again.";
            return;
        }

        try
        {
            await using var db = DbFactory.CreateDbContext();
            var tracked = await db.Issues.Include(i => i.Comments)
                .FirstOrDefaultAsync(i => i.Id == IssueId);
            if (tracked is null)
            {
                _commentError = "This issue no longer exists.";
                return;
            }

            var comment = tracked.AddComment(_currentUserId, _newComment.Trim(), Clock.UtcNow);
            // Domain-assigned Guid key → EF would UPDATE (0 rows) instead of
            // INSERT; force the new owned child to Added.
            db.Entry(comment).State = EntityState.Added;
            await db.SaveChangesAsync();

            _newComment = "";
            _changed = true;
            await ReloadCommentsCoreAsync();
        }
        catch (Exception ex)
        {
            _commentError = $"Couldn't post comment: {ex.Message}";
            return;
        }

        await BroadcastCommentsChangedAsync();
    }

    private void OnCommentDblClick(Comment c)
    {
        // Author-only; the domain enforces this again on save/delete.
        if (!_canWrite || c.AuthorId != _currentUserId) return;
        _commentError = null;
        _editingCommentId = c.Id;
        _editBody = c.Body;
    }

    private void CancelEditComment()
    {
        _editingCommentId = null;
        _editBody = "";
    }

    private async Task SaveEditCommentAsync()
    {
        if (!_canWrite || _editingCommentId is not { } id || string.IsNullOrWhiteSpace(_editBody)) return;
        _commentError = null;
        try
        {
            await using var db = DbFactory.CreateDbContext();
            var tracked = await db.Issues.Include(i => i.Comments)
                .FirstOrDefaultAsync(i => i.Id == IssueId);
            if (tracked is null) { _commentError = "This issue no longer exists."; return; }

            tracked.EditComment(id, _currentUserId, _editBody.Trim(), Clock.UtcNow);
            await db.SaveChangesAsync();

            _editingCommentId = null;
            _editBody = "";
            _changed = true;
            await ReloadCommentsCoreAsync();
        }
        catch (Exception ex)
        {
            _commentError = $"Couldn't save edit: {ex.Message}";
            return;
        }

        await BroadcastCommentsChangedAsync();
    }

    private async Task DeleteCommentAsync(Guid commentId)
    {
        if (!_canWrite) return;
        _commentError = null;
        try
        {
            await using var db = DbFactory.CreateDbContext();
            var tracked = await db.Issues.Include(i => i.Comments)
                .FirstOrDefaultAsync(i => i.Id == IssueId);
            if (tracked is null) { _commentError = "This issue no longer exists."; return; }

            tracked.RemoveComment(commentId, _currentUserId, Clock.UtcNow);
            await db.SaveChangesAsync();

            if (_editingCommentId == commentId) { _editingCommentId = null; _editBody = ""; }
            _changed = true;
            await ReloadCommentsCoreAsync();
        }
        catch (Exception ex)
        {
            _commentError = $"Couldn't delete comment: {ex.Message}";
            return;
        }

        await BroadcastCommentsChangedAsync();
    }

    // Tell other clients viewing this issue/project to reload their comment
    // list (covers add, edit, and delete). _ownPublishInFlight makes this
    // circuit ignore its own echo.
    private async Task BroadcastCommentsChangedAsync()
    {
        if (_groupName is null || _issue is null) return;
        _ownPublishInFlight = true;
        try
        {
            await Realtime.PublishAsync(
                _groupName,
                "CommentsChanged",
                new { issueId = IssueId, projectId = _issue.ProjectId },
                default);
        }
        catch
        {
            // The change is already persisted; a broadcast failure is non-fatal.
        }
        finally
        {
            _ownPublishInFlight = false;
        }
    }

    private async Task ReloadCommentsCoreAsync()
    {
        await using var db = DbFactory.CreateDbContext();
        var fresh = await db.Issues.AsNoTracking()
            .Include(i => i.Comments)
            .FirstOrDefaultAsync(i => i.Id == IssueId);
        _comments = fresh?.Comments.OrderByDescending(c => c.CreatedAt).ToList() ?? new();
    }

    [JSInvokable]
    public async Task OnUploadComplete(Guid attachmentId)
    {
        _attachError = null;
        _changed = true;
        try { await ReloadAttachmentsCoreAsync(); }
        catch (Exception ex) { _attachError = $"Refresh failed: {ex.Message}"; }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnUploadError(string message)
    {
        _attachError = $"Upload failed: {message}";
        return InvokeAsync(StateHasChanged);
    }

    private async Task ReloadAttachmentsCoreAsync()
    {
        var list = await Attachments.ListAsync(IssueId, default);
        _attachments = list.ToList();
    }

    private async Task DownloadAsync(Guid attachmentId)
    {
        Uri? url = null;
        try { url = await Attachments.GetDownloadUrlAsync(attachmentId, TimeSpan.FromMinutes(15), default); }
        catch (Exception ex) { _attachError = $"Download failed: {ex.Message}"; }
        if (url is not null) await JS.InvokeVoidAsync("open", url.ToString(), "_blank");
    }

    private async Task DeleteAttachmentAsync(Guid attachmentId)
    {
        if (!_canWrite) return;
        try
        {
            if (await Attachments.DeleteAsync(attachmentId, default))
            {
                _changed = true;
                await ReloadAttachmentsCoreAsync();
            }
        }
        catch (Exception ex) { _attachError = $"Delete failed: {ex.Message}"; }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes / 1024.0 / 1024.0:0.##} MB";
    }

    public ValueTask DisposeAsync()
    {
        _rtSubscription?.Dispose();
        _selfRef?.Dispose();
        return ValueTask.CompletedTask;
    }

    private sealed class EditModel
    {
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public IssueType Type { get; set; } = IssueType.Task;
        public IssueStatus Status { get; set; } = IssueStatus.Todo;
        public IssuePriority Priority { get; set; } = IssuePriority.Medium;
        public int? Points { get; set; }
        public string? AcceptanceCriteria { get; set; }
        public Guid? AssigneeId { get; set; }
        public Guid ReporterId { get; set; }
        public string? Labels { get; set; }
        public Guid? SprintId { get; set; }
    }

    private static IEnumerable<string> SplitLabels(string? csv) =>
        string.IsNullOrWhiteSpace(csv)
            ? Array.Empty<string>()
            : csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}
