@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectJA.Host.Theming
@using ProjectJA.Modules.Identity.Contracts
@inject ThemeCatalog Catalog
@inject ThemeState ThemeState
@inject AvatarState AvatarState
@inject TooltipState TooltipState
@inject AuthenticationStateProvider Auth
@inject IUserPreferences Preferences

<MudThemeProvider Theme="@Catalog.Resolve(ThemeState.ThemeKey)" IsDarkMode="@ThemeState.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Default">
        <MudText Typo="Typo.h6" Style="font-weight:600;">
            <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None">ProjectJA</MudLink>
        </MudText>

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <MudButton Href="/projects" Variant="Variant.Text" Color="Color.Inherit">Projects</MudButton>
                <MudButton Href="/my-issues" Variant="Variant.Text" Color="Color.Inherit">My Issues</MudButton>
                @* Admin-only nav. Hidden for non-OrgAdmins so they don't see
                   broken links — the pages themselves also enforce the policy
                   (defense in depth). *@
                <AuthorizeView Policy="OrgAdmin" Context="orgAdminCtx">
                    <Authorized>
                        <MudButton Href="/invites" Variant="Variant.Text" Color="Color.Inherit">Invites</MudButton>
                        <MudButton Href="/audit" Variant="Variant.Text" Color="Color.Inherit">Audit</MudButton>
                        <MudButton Href="/admin/email-outbox" Variant="Variant.Text" Color="Color.Inherit">Outbox</MudButton>
                        <MudButton Href="/admin/oidc-settings" Variant="Variant.Text" Color="Color.Inherit">SSO</MudButton>
                        <MudButton Href="/admin/users" Variant="Variant.Text" Color="Color.Inherit">Users</MudButton>
                        <MudTooltip Text="Runtime, app, database & loaded-library versions">
                            <MudButton Href="/system/versioning" Variant="Variant.Text" Color="Color.Inherit"
                                       StartIcon="@Icons.Material.Filled.Info">System</MudButton>
                        </MudTooltip>
                    </Authorized>
                </AuthorizeView>

                <form method="get" action="/search" style="margin: 0 0.5rem;">
                    <input type="text" name="q" placeholder="Search issues…"
                           class="mud-input" style="padding:0.4rem 0.6rem;border:1px solid #ccc;border-radius:4px;background:white;width:18rem;" />
                </form>

                <NotificationBell />

                <MudMenu @ref="_userMenu" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent Context="menuCtx">
                        @* MudBlazor only auto-wires click → ToggleMenuAsync on the
                           built-in Icon/Label activators. With ActivatorContent we
                           wire the click ourselves through an @ref. *@
                        <div @onclick="OpenUserMenuAsync" style="cursor:pointer;display:inline-flex;">
                            <UserAvatar AvatarKey="@AvatarState.AvatarKey"
                                        DisplayName="@context.User.Identity?.Name"
                                        Size="Size.Medium" />
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                    <MudMenuItem>
                        <MudText Typo="Typo.body2">@context.User.Identity?.Name</MudText>
                    </MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Href="/notifications" Icon="@Icons.Material.Filled.Notifications">Notifications</MudMenuItem>
                    <MudMenuItem Href="/settings" Icon="@Icons.Material.Filled.Settings">Settings</MudMenuItem>
                    <MudMenuItem>
                        <form method="post" action="/logout" style="margin:0;width:100%;">
                            <AntiforgeryToken />
                            <button type="submit"
                                    style="all:unset;cursor:pointer;display:block;width:100%;">
                                Sign out
                            </button>
                        </form>
                    </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary">Sign in</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private bool _themeLoaded;
    private MudMenu? _userMenu;

    private async Task OpenUserMenuAsync()
    {
        if (_userMenu is not null) await _userMenu.OpenMenuAsync(EventArgs.Empty);
    }

    protected override void OnInitialized()
    {
        ThemeState.Changed += OnThemeChanged;
        AvatarState.Changed += OnAvatarChanged;
    }

    private void OnAvatarChanged() => InvokeAsync(StateHasChanged);

    // The theme preference read is deliberately NOT in OnInitializedAsync: the
    // whole circuit shares one scoped AppDbContext, and a DB call here would run
    // concurrently with the routed page's own OnInitializedAsync DB calls
    // ("a second operation was started on this context instance"). OnAfterRender
    // for firstRender runs only after every component's OnInitializedAsync (and
    // their DB work) has completed, so this single read can't overlap anything.
    // Brief default-theme flash before this lands is the accepted Slice-1 FOUC.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeLoaded) return;
        _themeLoaded = true;

        var authState = await Auth.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true
            && Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var userId))
        {
            var pref = await Preferences.GetThemeAsync(userId, default);
            ThemeState.Set(Catalog.IsKnown(pref.ThemeKey) ? pref.ThemeKey : null, pref.Dark);
            var avatarKey = await Preferences.GetAvatarKeyAsync(userId, default);
            AvatarState.Set(avatarKey);
            var tooltipsOn = await Preferences.GetTooltipsEnabledAsync(userId, default);
            TooltipState.Set(tooltipsOn);
        }
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ThemeState.Changed -= OnThemeChanged;
        AvatarState.Changed -= OnAvatarChanged;
    }
}
